module

public import Fragment.ModularModel
public import Fragment.ModularSemantics
public import Fragment.InstallNest

@[expose] public section

/-!
# The fragment's model as a modular semantics

The fragment's consistency proof, packaged as an instance of the
interface of `ModularSemantics.lean` (`fragmentSemantics`), and the
modular theorem (`modular`) read off the generic one
(`Development.modular`).

* **Environments** are lists of **pieces** (`Piece`, `ModularModel.lean`):
  an environment with its resolution of names to qualified names.  A
  module's context and its own environment are one piece each; the
  world is the list of the checked modules' own environments.
* **A model** of a list of pieces (`WMod`) is an assignment of sets to
  the qualified names — the point at every proof and off the names the
  list stores — under which every piece has a model, read through its
  resolution.
* **Refinement** (`Ref`) is generated by reading (`PReads`: every
  constant of a piece refines a constant of the list under its
  qualified name), renaming the qualified names, sublists, unions and
  composition.  **Restriction** is reading the assignment through the
  renaming (`WMod.restrict`); along a reading, a piece's model is the
  restriction of its sources' models (`PReads.model`).
* **The step** is the installation of a checked list
  (`Checks.blockModel`); **amalgamation** adds the new piece's
  qualified names to the world's assignment; **the base** is the empty
  list.
-/

namespace Fragment

open SetLib IndLib

universe u

variable {V : Type u} [IndLib V]

/-! ## Qualified names stored by a list of pieces -/

/-- Is a qualified name a proof's. -/
def Key.isProof : Key → Bool
  | .qual .. => false
  | .proof .. => true

/-- The name a qualified name names. -/
def Key.name : Key → Name
  | .qual _ n => n
  | .proof n _ _ => n

/-- **The qualified names a list of pieces stores.** -/
def Keys (X : List Piece) (k : Key) : Prop :=
  ∃ p ∈ X, ∃ n, (p.env.find? n).isSome ∧ p.res n = k

theorem Keys.append {X Y : List Piece} {k : Key} : Keys (X ++ Y) k ↔ Keys X k ∨ Keys Y k := by
  unfold Keys
  constructor
  · rintro ⟨p, hp, h⟩
    rcases List.mem_append.mp hp with hp | hp
    · exact .inl ⟨p, hp, h⟩
    · exact .inr ⟨p, hp, h⟩
  · rintro (⟨p, hp, h⟩ | ⟨p, hp, h⟩)
    · exact ⟨p, List.mem_append_left _ hp, h⟩
    · exact ⟨p, List.mem_append_right _ hp, h⟩

theorem Keys.rename {X : List Piece} {ρ : Key → Key} {k : Key} :
    Keys (X.map (Piece.rename ρ)) k ↔ ∃ k', Keys X k' ∧ ρ k' = k := by
  unfold Keys
  constructor
  · rintro ⟨p, hp, n, hn, rfl⟩
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hp
    exact ⟨q.res n, ⟨q, hq, n, hn, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨q, hq, n, hn, rfl⟩, rfl⟩
    exact ⟨q.rename ρ, List.mem_map_of_mem hq, n, hn, rfl⟩

theorem Keys.single {p : Piece} {k : Key} :
    Keys [p] k ↔ ∃ n, (p.env.find? n).isSome ∧ p.res n = k := by
  unfold Keys
  simp

/-! ## Models: assignments of the qualified names -/

/-- A proof's set, and an unnamed key's: the point. -/
def dflt : List Nat → V := fun _ => pt

/-- **Every piece of a list has a model**, read through its resolution
from `G`. -/
def PiecesOk (V : Type u) [IndLib V] (X : List Piece) (G : Key → List Nat → V) : Prop :=
  ∀ p ∈ X, ∃ m : BlockModel V p.env,
    ∀ n, (p.env.find? n).isSome → ∀ ls, m.M n ls = G (p.res n) ls

theorem PiecesOk.congr {X : List Piece} {G G' : Key → List Nat → V} (h : PiecesOk V X G)
    (he : ∀ k, Keys X k → G' k = G k) : PiecesOk V X G' := by
  intro p hp
  obtain ⟨m, hm⟩ := h p hp
  exact ⟨m, fun n hn ls => by rw [hm n hn ls, he _ ⟨p, hp, n, hn, rfl⟩]⟩

/-- **A model of a list of pieces**: an assignment of the qualified
names, the point at every proof and off the names the list stores,
under which every piece has a model. -/
structure WMod (V : Type u) [IndLib V] (X : List Piece) where
  G : Key → List Nat → V
  off : ∀ k, ¬ Keys X k → G k = dflt
  prf : ∀ n lps T, G (.proof n lps T) = dflt
  pieces : PiecesOk V X G

theorem WMod.ext {X : List Piece} {m m' : WMod V X} (h : m.G = m'.G) : m = m' := by
  cases m; cases m'; cases h; rfl

theorem WMod.prf' {X : List Piece} (m : WMod V X) {k : Key} (hk : k.isProof = true) :
    m.G k = dflt := by
  cases k with
  | qual => simp [Key.isProof] at hk
  | proof n lps T => exact m.prf n lps T

open Classical in
/-- An assignment set to the point off the names of `X`. -/
noncomputable def normalize (X : List Piece) (G : Key → List Nat → V) : Key → List Nat → V :=
  fun k => if Keys X k then G k else dflt

theorem normalize_pos {X : List Piece} {G : Key → List Nat → V} {k : Key} (h : Keys X k) :
    normalize X G k = G k := by
  simp [normalize, h]

theorem normalize_neg {X : List Piece} {G : Key → List Nat → V} {k : Key} (h : ¬ Keys X k) :
    normalize X G k = dflt := by
  simp [normalize, h]

/-! ## Refinement -/

/-- **A renaming keeps proofs' names proofs' names**, on the names
of `X`. -/
def KeyMap (ρ : Key → Key) (X : List Piece) : Prop := ∀ k, Keys X k → (ρ k).isProof = k.isProof

/-- **Refinement with renaming** of lists of pieces: generated by
reading (`PReads`), renaming, sublists, unions and composition. -/
inductive Ref : List Piece → (Key → Key) → List Piece → Prop
  | reads {P Q : List Piece} : (∀ p ∈ P, PReads p Q) → Ref P id Q
  | ren {P : List Piece} {ρ : Key → Key} : KeyMap ρ P → Ref P ρ (P.map (Piece.rename ρ))
  | sub {P Q : List Piece} : P ⊆ Q → Ref P id Q
  | union {P P' Q : List Piece} {ρ : Key → Key} : Ref P ρ Q → Ref P' ρ Q → Ref (P ++ P') ρ Q
  | trans {P Q R : List Piece} {ρ σ : Key → Key} : Ref P ρ Q → Ref Q σ R → Ref P (σ ∘ ρ) R

/-- **A refinement maps stored names to stored names**, proofs' to
proofs'. -/
theorem Ref.keys {P Q : List Piece} {ρ : Key → Key} (h : Ref P ρ Q) :
    ∀ k, Keys P k → Keys Q (ρ k) ∧ (ρ k).isProof = k.isProof := by
  induction h with
  | reads hr =>
    rintro _ ⟨p, hp, n, hn, rfl⟩
    obtain ⟨ci, hci⟩ := Option.isSome_iff_exists.mp hn
    obtain ⟨q, hq, hres, ci', hf', -⟩ := (hr p hp).le n ci hci
    exact ⟨⟨q, hq, n, by rw [hf']; rfl, hres⟩, rfl⟩
  | ren hk =>
    rintro _ ⟨p, hp, n, hn, rfl⟩
    exact ⟨⟨p.rename _, List.mem_map_of_mem hp, n, hn, rfl⟩, hk _ ⟨p, hp, n, hn, rfl⟩⟩
  | sub hs =>
    rintro _ ⟨p, hp, n, hn, rfl⟩
    exact ⟨⟨p, hs hp, n, hn, rfl⟩, rfl⟩
  | union _ _ ih₁ ih₂ =>
    intro k hk
    rcases Keys.append.mp hk with hk | hk
    · exact ih₁ k hk
    · exact ih₂ k hk
  | trans _ _ ih₁ ih₂ =>
    intro k hk
    obtain ⟨h1, e1⟩ := ih₁ k hk
    obtain ⟨h2, e2⟩ := ih₂ _ h1
    exact ⟨h2, e2.trans e1⟩

/-- **Along a refinement, the pieces' models carry over**, read
through the renaming. -/
theorem Ref.pieces {P Q : List Piece} {ρ : Key → Key} (h : Ref P ρ Q) :
    ∀ G : Key → List Nat → V, PiecesOk V Q G → PiecesOk V P (G ∘ ρ) := by
  induction h with
  | reads hr =>
    intro G hQ p hp
    obtain ⟨m, hm⟩ := (hr p hp).model G hQ
    exact ⟨m, fun n _ ls => by rw [hm]; rfl⟩
  | ren _ =>
    intro G hQ p hp
    obtain ⟨m, hm⟩ := hQ _ (List.mem_map_of_mem hp)
    exact ⟨m, fun n hn ls => hm n hn ls⟩
  | sub hs =>
    intro G hQ p hp
    exact hQ p (hs hp)
  | union _ _ ih₁ ih₂ =>
    intro G hQ p hp
    rcases List.mem_append.mp hp with hp | hp
    · exact ih₁ G hQ p hp
    · exact ih₂ G hQ p hp
  | trans _ _ ih₁ ih₂ =>
    intro G hQ
    exact ih₁ _ (ih₂ G hQ)

/-- **Restriction**: the assignment read through the renaming. -/
noncomputable def WMod.restrict {P Q : List Piece} {ρ : Key → Key} (h : Ref P ρ Q)
    (m : WMod V Q) : WMod V P where
  G := normalize P (m.G ∘ ρ)
  off _ hk := normalize_neg hk
  prf n lps T := by
    by_cases hk : Keys P (.proof n lps T)
    · rw [normalize_pos hk]
      exact m.prf' (by rw [(h.keys _ hk).2]; rfl)
    · exact normalize_neg hk
  pieces := (h.pieces _ m.pieces).congr fun _ hk => normalize_pos hk

theorem WMod.restrict_G {P Q : List Piece} {ρ : Key → Key} (h : Ref P ρ Q) (m : WMod V Q) :
    (WMod.restrict h m).G = normalize P (m.G ∘ ρ) := rfl


/-! ## Amalgamation -/

/-- **Freshness**: the renaming names the own piece's qualified names
apart and keeps proofs' names proofs', and a name the own piece adds
that the world already stores is a proof's. -/
def FFresh (W : List Piece) (ρ : Key → Key) (Γ Γ' : List Piece) : Prop :=
  (∀ k k', Keys Γ' k → Keys Γ' k' → ρ k = ρ k' → k = k') ∧ KeyMap ρ Γ' ∧
    ∀ k, Keys Γ' k → ¬ Keys Γ k → Keys W (ρ k) → k.isProof = true

/-- The world with a piece added, renamed. -/
def fglue (W : List Piece) (ρ : Key → Key) (Γ' : List Piece) : List Piece :=
  W ++ Γ'.map (Piece.rename ρ)

theorem fglue_left {W Γ' : List Piece} {ρ : Key → Key} : Ref W id (fglue W ρ Γ') :=
  .sub (List.subset_append_left _ _)

theorem fglue_right {Γ Γ' W : List Piece} {ρ : Key → Key} (f : FFresh W ρ Γ Γ') :
    Ref Γ' ρ (fglue W ρ Γ') :=
  .trans (σ := id) (.ren f.2.1) (.sub (List.subset_append_right _ _))

/-- **Amalgamation**: a model of the world and one of the own piece
that agree on the context make one of the world with the own piece
added. -/
theorem famalgamate {Γ Γ' W : List Piece} {ρ : Key → Key} (r : Ref Γ ρ W) (a : Ref Γ id Γ')
    (f : FFresh W ρ Γ Γ') (mW : WMod V W) (m' : WMod V Γ')
    (he : WMod.restrict r mW = WMod.restrict a m') :
    ∃ m'' : WMod V (fglue W ρ Γ'), WMod.restrict fglue_left m'' = mW ∧
      WMod.restrict (fglue_right f) m'' = m' := by
  have hinj := f.1
  have hmap := f.2.1
  have hnew := f.2.2
  have hG := congrArg WMod.G he
  simp only [WMod.restrict_G] at hG
  have hctx : ∀ k, Keys Γ k → mW.G (ρ k) = m'.G k := by
    intro k hk
    have := congrFun hG k
    rwa [normalize_pos hk, normalize_pos hk] at this
  open Classical in
  let G'' : Key → List Nat → V := fun k =>
    if Keys W k then mW.G k
    else if hk : ∃ k', Keys Γ' k' ∧ ρ k' = k then m'.G (Classical.choose hk) else dflt
  have hold : ∀ k, Keys W k → G'' k = mW.G k := fun k hk => by simp only [G'', ite_eq_left hk]
  have hat : ∀ k, Keys Γ' k → G'' (ρ k) = m'.G k := by
    intro k hk
    by_cases hW : Keys W (ρ k)
    · rw [hold _ hW]
      by_cases hΓ : Keys Γ k
      · exact hctx k hΓ
      · have hp := hnew k hk hΓ hW
        rw [m'.prf' hp, mW.prf' (by rw [hmap k hk]; exact hp)]
    · have hex : ∃ k', Keys Γ' k' ∧ ρ k' = ρ k := ⟨k, hk, rfl⟩
      simp only [G'', ite_eq_right hW, dite_eq_left hex]
      obtain ⟨h1, h2⟩ := Classical.choose_spec hex
      rw [hinj _ _ h1 hk h2]
  refine ⟨{ G := G'', off := ?_, prf := ?_, pieces := ?_ }, WMod.ext ?_, WMod.ext ?_⟩
  · intro k hk
    have hW : ¬ Keys W k := fun h => hk (Keys.append.mpr (.inl h))
    have hex : ¬ ∃ k', Keys Γ' k' ∧ ρ k' = k :=
      fun h => hk (Keys.append.mpr (.inr (Keys.rename.mpr h)))
    simp only [G'', ite_eq_right hW, dite_eq_right hex]
  · intro n lps T
    by_cases hW : Keys W (.proof n lps T)
    · rw [hold _ hW]; exact mW.prf n lps T
    · by_cases hex : ∃ k', Keys Γ' k' ∧ ρ k' = .proof n lps T
      · obtain ⟨k', hk', hr⟩ := hex
        rw [← hr, hat k' hk']
        exact m'.prf' (by rw [← hmap k' hk', hr]; rfl)
      · simp only [G'', ite_eq_right hW, dite_eq_right hex]
  · intro p hp
    rcases List.mem_append.mp hp with hp | hp
    · exact (mW.pieces p hp).imp fun mp hmp n hn ls => by
        rw [hmp n hn ls, hold _ ⟨p, hp, n, hn, rfl⟩]
    · obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hp
      exact (m'.pieces q hq).imp fun mp hmp n hn ls => by
        show _ = G'' (ρ (q.res n)) ls
        rw [hmp n hn ls, hat _ ⟨q, hq, n, hn, rfl⟩]
  · rw [WMod.restrict_G]
    funext k
    by_cases hk : Keys W k
    · rw [normalize_pos hk]; exact hold k hk
    · rw [normalize_neg hk, mW.off k hk]
  · rw [WMod.restrict_G]
    funext k
    by_cases hk : Keys Γ' k
    · rw [normalize_pos hk]; exact hat k hk
    · rw [normalize_neg hk, m'.off k hk]

/-! ## Acceptance and the step -/

variable [LevelOracle]

omit [IndLib V] in
/-- **A checked declaration's names are fresh.** -/
theorem Decl.Ok.fresh {E : Env} {d : Decl} (h : d.Ok E) : ∀ m ∈ d.names, E.find? m = none := by
  cases d with
  | defn c ci =>
    intro m hm
    simp only [Decl.names, List.mem_singleton] at hm
    subst hm; exact h.1
  | thm c ci v =>
    intro m hm
    simp only [Decl.names, List.mem_singleton] at hm
    subst hm; exact h.2.1.1
  | ind S =>
    intro m hm
    change m ∈ S.names at hm
    unfold IndSpec.names at hm
    change IndOk E S at h
    unfold IndOk at h
    cases hn : S.nest with
    | none => rw [hn] at h hm; exact h.fresh m hm
    | some N => rw [hn] at h hm; exact h.fresh m hm

/-- **A checked list keeps every constant of its environment.** -/
theorem Checks.keep {E : Env} {ds : List Decl} (hc : Checks E ds) :
    ∀ {n ci}, E.find? n = some ci → (applyAll ds E).find? n = some ci := by
  induction hc with
  | nil => exact fun h => h
  | @cons E d ds hd _ ih =>
    intro n ci h
    apply ih
    rw [Decl.apply_eq]
    cases hl : d.stores.lookup n with
    | none => simp only [Env.find?, lookup_append_of_none hl]; exact h
    | some e =>
      have hn : n ∈ d.names := (d.mem_names_iff n).mpr ⟨e, key_of_lookup hl⟩
      rw [hd.fresh n hn] at h; cases h

omit [IndLib V] [LevelOracle] in
theorem isSome_find?_applyAll {ds : List Decl} :
    ∀ {E : Env} {n : Name}, (E.find? n).isSome → ((applyAll ds E).find? n).isSome := by
  induction ds with
  | nil => exact fun h => h
  | cons d ds ih => exact fun h => ih (isSome_find?_apply h d)

omit [IndLib V] [LevelOracle] in
/-- A declaration's names are stored after the list. -/
theorem isSome_find?_applyAll_of_mem {ds : List Decl} :
    ∀ {E : Env} {d : Decl}, d ∈ ds → ∀ n ∈ d.names, ((applyAll ds E).find? n).isSome := by
  induction ds with
  | nil => intro _ _ h; cases h
  | cons d' ds ih =>
    intro E d hd n hn
    rcases List.mem_cons.mp hd with rfl | hd
    · show ((applyAll ds (d.apply E)).find? n).isSome
      apply isSome_find?_applyAll
      rw [Decl.apply_eq]
      obtain ⟨e, he⟩ := (d.mem_names_iff n).mp hn
      cases hl : d.stores.lookup n with
      | none => exact absurd hl (lookup_ne_none_of_mem he)
      | some e' => simp [Env.find?, lookup_append_of_some hl]
    · exact ih hd n hn

/-- **Acceptance**: a context piece and the checked list over it, with
its proof flags; the own piece reads from itself what the context
stores, the resolution names the own constants apart, and a name
resolved to a proof's is flagged. -/
def FAccepts (Γ : List Piece) (D : List Decl × (Name → Bool)) (Γ' : List Piece) : Prop :=
  ∃ C r, Γ = [⟨C, r⟩] ∧ Γ' = [⟨applyAll D.1 C, r⟩] ∧ Checks C D.1 ∧ FlagsOk D.2 C D.1 ∧
    PReads ⟨C, r⟩ [⟨applyAll D.1 C, r⟩] ∧
    (∀ n n', ((applyAll D.1 C).find? n).isSome → ((applyAll D.1 C).find? n').isSome →
      r n = r n' → n = n') ∧
    (∀ d ∈ D.1, ∀ n ∈ d.names, (r n).isProof = true → D.2 n = true)

theorem FAccepts.ref {Γ Γ' : List Piece} {D : List Decl × (Name → Bool)} (h : FAccepts Γ D Γ') :
    Ref Γ id Γ' := by
  obtain ⟨C, r, rfl, rfl, -, -, hR, -⟩ := h
  exact .reads fun p hp => by
    simp only [List.mem_singleton] at hp; subst hp; exact hR

/-- **The step**: a model of the context extends to one of the own
environment restricting back to it. -/
theorem FAccepts.step {Γ Γ' : List Piece} {D : List Decl × (Name → Bool)} (h : FAccepts Γ D Γ')
    (m : WMod V Γ) : ∃ m' : WMod V Γ', WMod.restrict h.ref m' = m := by
  obtain ⟨C, r, rfl, rfl, hc, hfl, hR, hinj, hpf⟩ := h
  obtain ⟨mc, hmc⟩ := m.pieces _ (List.mem_singleton_self _)
  obtain ⟨m', hag, hpt⟩ := hc.blockModel D.2 hfl hR.scoped mc
  let E' := applyAll D.1 C
  open Classical in
  let G' : Key → List Nat → V := fun k =>
    if hk : ∃ n, (E'.find? n).isSome ∧ r n = k then m'.M (Classical.choose hk) else dflt
  have hat : ∀ n, (E'.find? n).isSome → G' (r n) = m'.M n := by
    intro n hn
    have hk : ∃ n', (E'.find? n').isSome ∧ r n' = r n := ⟨n, hn, rfl⟩
    simp only [G', dite_eq_left hk]
    obtain ⟨h1, h2⟩ := Classical.choose_spec hk
    rw [hinj _ _ h1 hn h2]
  have hctx : ∀ n, (C.find? n).isSome → G' (r n) = m.G (r n) := by
    intro n hn
    rw [hat n (isSome_find?_applyAll hn)]
    funext ls
    rw [hag n hn ls, hmc n hn ls]
  refine ⟨{ G := G', off := ?_, prf := ?_, pieces := ?_ }, WMod.ext ?_⟩
  · intro k hk
    have : ¬ ∃ n, (E'.find? n).isSome ∧ r n = k := fun h => hk (Keys.single.mpr h)
    simp only [G', dite_eq_right this]
  · intro n lps T
    by_cases hk : ∃ n', (E'.find? n').isSome ∧ r n' = .proof n lps T
    · obtain ⟨n', hn', hr'⟩ := hk
      rw [← hr', hat n' hn']
      cases hC : C.find? n' with
      | some ci =>
        have hs : (C.find? n').isSome := by rw [hC]; rfl
        funext ls
        rw [hag n' hs ls, hmc n' hs ls]
        show m.G (r n') ls = _
        rw [hr', m.prf]
      | none =>
        obtain ⟨e, he⟩ := Option.isSome_iff_exists.mp hn'
        rcases find?_applyAll he with ⟨d, hd, hl⟩ | hl
        · have hnm : n' ∈ d.names := (d.mem_names_iff n').mpr ⟨e, key_of_lookup hl⟩
          have hp : D.2 n' = true := hpf d hd n' hnm (by rw [hr']; rfl)
          funext ls
          exact hpt d hd n' hnm hp ls
        · rw [hC] at hl; cases hl
    · simp only [G', dite_eq_right hk]
  · intro p hp
    simp only [List.mem_singleton] at hp; subst hp
    exact ⟨m', fun n hn ls => by rw [hat n hn]⟩
  · rw [WMod.restrict_G]
    funext k
    by_cases hk : Keys [⟨C, r⟩] k
    · rw [normalize_pos hk]
      obtain ⟨n, hn, rfl⟩ := Keys.single.mp hk
      exact hctx n hn
    · rw [normalize_neg hk, m.off k hk]

/-! ## The instance -/

variable (V) in
/-- **The fragment's model as a modular semantics.** -/
@[reducible] noncomputable def fragmentSemantics : ModularSemantics.{0, u} where
  Env := List Piece
  Name := Key
  Refines := Ref
  refines_id E := .sub (List.Subset.refl E)
  refines_comp h₁ h₂ := .trans h₁ h₂
  Mod := WMod V
  restrict := WMod.restrict
  restrict_id {E} m := WMod.ext <| by
    rw [WMod.restrict_G]
    funext k
    by_cases hk : Keys E k
    · rw [normalize_pos hk]; rfl
    · rw [normalize_neg hk, m.off k hk]
  restrict_comp {Γ E F ρ σ} h₁ h₂ m := WMod.ext <| by
    simp only [WMod.restrict_G]
    funext k
    by_cases hk : Keys Γ k
    · rw [normalize_pos hk, normalize_pos hk]
      exact (normalize_pos (G := m.G ∘ σ) (h₁.keys k hk).1).symm
    · rw [normalize_neg hk, normalize_neg hk]
  Decls := List Decl × (Name → Bool)
  Accepts := FAccepts
  accepts_refines h := h.ref
  step h m := h.step m
  Fresh := FFresh
  glue := fglue
  glue_left := fglue_left
  glue_right _ _ f := fglue_right f
  amalgamate r a f mW m' he := famalgamate r a.ref f mW m' he
  base := []
  baseModel := { G := fun _ => (dflt : List Nat → V), off := fun _ _ => rfl, prf := fun _ _ _ => rfl,
                 pieces := fun _ h => nomatch h }

/-! ## A development of modules, over the instance -/

/-- Module `j`'s own environment as a piece. -/
def piece (dev : Nat → Module) (j : Nat) : Piece := ⟨(dev j).own, (dev j).res⟩

variable (V) in
open Classical in
/-- **The development**, over the fragment's semantics: a module is
compared when it does not pass the local checks. -/
noncomputable def toDev (dev : Nat → Module) : Development (fragmentSemantics V) where
  ctx i := [⟨(dev i).context, (dev i).res⟩]
  decls i := ((dev i).decls, (dev i).proofs)
  own i := [piece dev i]
  ren _ := id
  compared i := decide (¬ LocalOk dev i)

theorem toDev_compared {dev : Nat → Module} {i : Nat} :
    (toDev V dev).compared i = true ↔ ¬ LocalOk dev i := by
  simp [toDev]

omit [IndLib V] [LevelOracle] in
theorem rename_id (p : Piece) : p.rename id = p := rfl

/-- The world's pieces are earlier modules'; a checked module's is
there. -/
theorem world_pieces (dev : Nat → Module) :
    ∀ i, (∀ p ∈ (toDev V dev).world i, ∃ j < i, p = piece dev j) ∧
      (∀ j < i, LocalOk dev j → piece dev j ∈ (toDev V dev).world i) ∧
      (toDev V dev).world i ⊆ (toDev V dev).world (i + 1)
  | 0 => by
    refine ⟨fun p hp => ?_, fun j hj => absurd hj (Nat.not_lt_zero _), fun p hp => ?_⟩
    all_goals change p ∈ ([] : List Piece) at hp; cases hp
  | i + 1 => by
    obtain ⟨ih1, ih2, ih3⟩ := world_pieces dev i
    have hw : ∀ k, (toDev V dev).world (k + 1) = if (toDev V dev).compared k then
        (toDev V dev).world k else (toDev V dev).world k ++ [piece dev k] := by
      intro k
      show (if _ then _ else fglue _ id [piece dev k]) = _
      rfl
    have hsub : ∀ k, (toDev V dev).world k ⊆ (toDev V dev).world (k + 1) := by
      intro k p hp
      rw [hw k]; split
      · exact hp
      · exact List.mem_append_left _ hp
    refine ⟨fun p hp => ?_, fun j hj hl => ?_, hsub (i + 1)⟩
    · rw [hw i] at hp; split at hp
      · obtain ⟨j, hj, rfl⟩ := ih1 p hp; exact ⟨j, Nat.lt_succ_of_lt hj, rfl⟩
      · rcases List.mem_append.mp hp with hp | hp
        · obtain ⟨j, hj, rfl⟩ := ih1 p hp; exact ⟨j, Nat.lt_succ_of_lt hj, rfl⟩
        · simp only [List.mem_singleton] at hp; exact ⟨i, Nat.lt_succ_self i, hp⟩
    · rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | rfl
      · exact ih3 (ih2 j hj hl)
      · rw [hw j]
        have : (toDev V dev).compared j = false := by
          cases h : (toDev V dev).compared j
          · rfl
          · exact absurd hl (toDev_compared.mp h)
        simp only [this, Bool.false_eq_true, ↓reduceIte]
        exact List.mem_append_right _ (List.mem_singleton_self _)

theorem world_mono (dev : Nat → Module) {i k : Nat} (h : i ≤ k) :
    (toDev V dev).world i ⊆ (toDev V dev).world k := by
  induction h with
  | refl => exact List.Subset.refl _
  | step _ ih => exact fun p hp => (world_pieces (V := V) dev _).2.2 (ih hp)

/-- **The earlier modules' own environments refine the world.** -/
theorem below_ref (dev : Nat → Module) :
    ∀ i, (∀ j < i, Valid dev j) →
      Ref ((List.range i).map (piece dev)) id ((toDev V dev).world i)
  | 0, _ => .sub fun _ h => nomatch h
  | i + 1, hv => by
    have ih := below_ref dev i fun j hj => hv j (Nat.lt_succ_of_lt hj)
    have hsub := (world_pieces (V := V) dev i).2.2
    rw [List.range_succ, List.map_append]
    refine .union (.trans (σ := id) ih (.sub hsub)) ?_
    by_cases hl : LocalOk dev i
    · exact .sub fun p hp => by
        simp only [List.map_cons, List.map_nil, List.mem_singleton] at hp; subst hp
        exact (world_pieces (V := V) dev (i + 1)).2.1 i (Nat.lt_succ_self i) hl
    · have hc : Compared dev i := (hv i (Nat.lt_succ_self i)).resolve_left hl
      have hr : Ref [piece dev i] id ((List.range i).map (piece dev)) :=
        .reads fun p hp => by
          simp only [List.mem_singleton] at hp; subst hp
          exact hc.preads fun b hb => List.mem_map_of_mem (List.mem_range.mpr hb)
      exact .trans (σ := id) (.trans (σ := id) hr ih) (.sub hsub)

omit [IndLib V] [LevelOracle] in
/-- A reading's footprint grows with the environment read. -/
theorem EntryScoped.mono_of {A B E : Env} {ci : ConstInfo}
    (hm : ∀ d, (A.find? d).isSome → (B.find? d).isSome)
    (he : ∀ c cij, A.find? c = some cij → E.find? c = some cij → B.find? c = some cij)
    (h : EntryScoped A E ci) : EntryScoped B E ci := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  refine ⟨h1.mono hm, fun v hv => (h2 v hv).mono hm, fun nP nM nMin nI rules hk rl hrl => ?_,
    fun nP nI cs S hk hpl => ?_⟩
  · obtain ⟨hrhs, cij, hA, hE, hty⟩ := h3 nP nM nMin nI rules hk rl hrl
    exact ⟨hrhs.mono hm, cij, he _ _ hA hE, hE, hty.mono hm⟩
  · obtain ⟨hS, hn, hc⟩ := h4 nP nI cs S hk hpl
    exact ⟨hS.mono hm, hm _ hn, fun j c hj => hm _ (hc j c hj)⟩

/-- **A context reads from its own environment** what it stores. -/
theorem self_reads {dev : Nat → Module} {i : Nat} (h : LocalOk dev i) :
    PReads ⟨(dev i).context, (dev i).res⟩ [piece dev i] where
  le n ci hf := by
    obtain ⟨-, -, -, hsc⟩ := h.reads.le n ci hf
    have hself : ∀ d cd, (dev i).context.find? d = some cd →
        (readsAlikeP ⟨(dev i).context, (dev i).res⟩ (piece dev i)).find? d = some cd :=
      fun d cd hd => find?_readsAlikeP_of (h.checks.keep hd) (by rw [hd]; rfl) rfl
    refine ⟨piece dev i, List.mem_singleton_self _, rfl, ci, h.checks.keep hf, .inl rfl,
      hsc.mono_of (fun d hd => ?_) (fun c cij _ hE => hself c cij hE)⟩
    obtain ⟨e, he⟩ := Option.isSome_iff_exists.mp hd
    obtain ⟨cd, hcd⟩ := Option.isSome_iff_exists.mp (find?_readsAlike he).2.1
    rw [hself d cd hcd]; rfl
  blocks := h.reads.blocks

omit [IndLib V] [LevelOracle] in
theorem Key.Fits.name {dev : Nat → Module} {j : Nat} {n : Name} {ci : ConstInfo} {k : Key}
    (h : k.Fits dev j n ci) : k.name = n := by
  cases k with
  | qual P n' => exact h.1
  | proof n' lps T => exact h.1

/-- **A valid module is valid over the instance.** -/
theorem toDev_valid (dev : Nat → Module) (i : Nat) (hv : ∀ j ≤ i, Valid dev j) :
    (toDev V dev).Valid i := by
  have hfit := fits dev
  have hbelow := below_ref (V := V) dev i fun j hj => hv j (Nat.le_of_lt hj)
  have hmem : ∀ b < i, piece dev b ∈ (List.range i).map (piece dev) :=
    fun b hb => List.mem_map_of_mem (List.mem_range.mpr hb)
  unfold Development.Valid
  cases hc : (toDev V dev).compared i with
  | true =>
    simp only [↓reduceIte]
    have hl := toDev_compared.mp hc
    have hcmp : Compared dev i := (hv i (Nat.le_refl i)).resolve_left hl
    exact .trans (σ := id) (.reads fun p hp => by
      simp only [toDev, List.mem_singleton] at hp; subst hp; exact hcmp.preads hmem) hbelow
  | false =>
    simp only [Bool.false_eq_true, ↓reduceIte]
    have hl : LocalOk dev i := by
      refine Classical.byContradiction fun hn => ?_
      rw [toDev_compared.mpr hn] at hc; cases hc
    -- the own constants' qualified names name them
    have hname : ∀ n ci, (dev i).own.find? n = some ci → ((dev i).res n).name = n :=
      fun n ci hf => (hfit i hv n ci hf).name
    have hinj : ∀ n n', ((dev i).own.find? n).isSome → ((dev i).own.find? n').isSome →
        (dev i).res n = (dev i).res n' → n = n' := by
      intro n n' hn hn' he
      obtain ⟨ci, hci⟩ := Option.isSome_iff_exists.mp hn
      obtain ⟨ci', hci'⟩ := Option.isSome_iff_exists.mp hn'
      rw [← hname n ci hci, ← hname n' ci' hci', he]
    -- an own name resolves to the module's own qualified name or a proof's
    have hown : ∀ d ∈ (dev i).decls, ∀ n ∈ d.names,
        ((dev i).res n).isProof = true ∧ (dev i).proofs n = true ∨ (dev i).res n = .qual i n := by
      intro d hd n hn
      obtain ⟨ci, hci⟩ := Option.isSome_iff_exists.mp
        (isSome_find?_applyAll_of_mem (E := (dev i).context) hd n hn)
      rw [hl.res_own d hd n hn ci hci]
      unfold Module.ownKey
      split
      · rename_i hp; exact .inl ⟨rfl, hp⟩
      · exact .inr rfl
    refine ⟨.trans (σ := id) (.reads fun p hp => by
      simp only [toDev, List.mem_singleton] at hp; subst hp; exact hl.reads.preads hmem) hbelow,
      ⟨(dev i).context, (dev i).res, rfl, rfl, hl.checks, hl.flags, self_reads hl, hinj,
        fun d hd n hn hp => ?_⟩, fun k k' _ _ h => h, fun _ _ => rfl, ?_⟩
    · rcases hown d hd n hn with ⟨-, h⟩ | h
      · exact h
      · rw [h] at hp; cases hp
    · intro k hk hΓ hW
      obtain ⟨n, hn, rfl⟩ := Keys.single.mp hk
      obtain ⟨e, he⟩ := Option.isSome_iff_exists.mp hn
      rcases find?_applyAll he with ⟨d, hd, hlk⟩ | hlk
      · have hnm : n ∈ d.names := (d.mem_names_iff n).mpr ⟨e, key_of_lookup hlk⟩
        rcases hown d hd n hnm with ⟨h, -⟩ | h
        · exact h
        · exfalso
          obtain ⟨p, hp, n', hn', hk'⟩ := hW
          obtain ⟨j, hj, rfl⟩ := (world_pieces (V := V) dev i).1 p hp
          obtain ⟨ci', hci'⟩ := Option.isSome_iff_exists.mp hn'
          have hf := hfit j (fun j' hj' => hv j' (by omega)) n' ci' hci'
          have hk'' : (dev j).res n' = .qual i n := (show (dev j).res n' = (dev i).res n from hk').trans h
          rw [hk''] at hf
          obtain ⟨-, hP, -⟩ := hf
          omega
      · exact absurd (Keys.single.mpr ⟨n, by rw [hlk]; rfl, rfl⟩) hΓ

/-! ## The theorem -/

variable (V) in
/-- **Modular checking** (the theorem): if every module up to `i`
passes its local checks, there is one assignment of sets to the
qualified names — every proof the point — under which every module's
own environment, read through its resolution, has a model.  It is the
generic theorem (`Development.modular`) at the fragment's semantics. -/
theorem modular (dev : Nat → Module) (i : Nat) (h : ∀ j ≤ i, Valid dev j) :
    ∃ G : Key → List Nat → V, (∀ n lps T ls, G (.proof n lps T) ls = pt) ∧
      ∀ j ≤ i, ∃ m : BlockModel V (dev j).own,
        ∀ n, ((dev j).own.find? n).isSome → ∀ ls, m.M n ls = resAssign G (dev j) n ls := by
  obtain ⟨⟨m⟩, hr⟩ := (toDev V dev).modular (i + 1) fun j hj =>
    toDev_valid dev j fun k hk => h k (by omega)
  refine ⟨m.G, fun n lps T ls => by rw [m.prf]; rfl, fun j hj => ?_⟩
  obtain ⟨mj, hmj⟩ := (WMod.restrict (hr j (by omega)) m).pieces _ (List.mem_singleton_self _)
  refine ⟨mj, fun n hn ls => ?_⟩
  rw [hmj n hn ls, WMod.restrict_G]
  show normalize [piece dev j] (m.G ∘ id) ((dev j).res n) ls = _
  rw [normalize_pos (X := [piece dev j]) (G := m.G ∘ id) (k := (dev j).res n)
    (Keys.single.mpr ⟨n, hn, rfl⟩)]
  rfl

variable (V) in
/-- **Every module's own environment has a model.** -/
theorem modular_model (dev : Nat → Module) (i : Nat) (h : ∀ j ≤ i, Valid dev j) :
    Nonempty (BlockModel V (dev i).own) := by
  obtain ⟨G, -, hall⟩ := modular V dev i h
  obtain ⟨m, -⟩ := hall i (Nat.le_refl i)
  exact ⟨m⟩

variable (V) in
include V in
/-- **No closed term of a module inhabits an empty proposition** that
its own environment stores. -/
theorem modular_no_empty_prop_inhabitant (dev : Nat → Module) (i : Nat) (h : ∀ j ≤ i, Valid dev j)
    {name recName elim : Name}
    (hrec : (dev i).own.find? recName = some (IndSpec.falseSpec name recName elim).recInfo)
    (e : Expr) : ¬ Infer (dev i).own [] e (.const name []) := by
  obtain ⟨m⟩ := modular_model V dev i h
  exact no_empty_inductive_inhabitant_of_model V m.toEnvModel
    (S := IndSpec.falseSpec name recName elim) rfl rfl rfl rfl hrec e

variable (V) in
/-- **Every statement a module stores holds in its model** — in
particular every assumption of a compared module (a hole): its type,
at every instantiation, has a member. -/
theorem modular_statements_hold (dev : Nat → Module) (i : Nat) (h : ∀ j ≤ i, Valid dev j) :
    ∃ m : BlockModel V (dev i).own, ∀ c ci, (dev i).own.find? c = some ci →
      ∀ (φ : Name → Nat) (ρ : Nat → V) (ls : List Level), ls.length = ci.lparams.length →
        ∃ x, x ∈ˢ interp m.M φ ρ (ci.type.instL ci.lparams ls) := by
  obtain ⟨G, -, hall⟩ := modular V dev i h
  obtain ⟨m, -⟩ := hall i (Nat.le_refl i)
  exact ⟨m, fun c ci hf φ ρ ls hls => ⟨_, (m.type_ok c ci hf φ ρ ls hls).2.2⟩⟩

end Fragment
