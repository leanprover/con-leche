module

public import ConLeche.Modular.Generic
public import ConLeche.Model.Modular.Restrict
public import ConLeche.Model.Modular.Step

public section

/-!
# Con-leche's models as a modular semantics

The instance of `ConLeche.Modular.ModularSemantics`
(`ConLeche/Modular/Generic.lean`) for con-leche's graded models
(`conlecheSemantics`), so that the modular theorem is the generic one
(`Development.modular`) at con-leche's models.

* **Environments over qualified names** (`PEnv`): a list of pieces, each a
  con-leche environment with its resolution of names to qualified names
  (`Piece`).  A module's own environment is one piece; the world is the
  list of the checked modules' pieces.  Its keys (`PEnv.HasKey`) are the
  qualified names its pieces store.
* **Refinement** (`Ref`) is generated by four elementary refinements and
  composition: a list whose every piece **reads** from a list
  (`PieceReads`: each name read from a source piece, with what its laws
  read stored and resolved alike there — the reading `CtxRead` of
  `Restrict.lean`); a **renaming** of the keys that keeps which keys
  are proofs (`KeyMap`); a **sublist**; a **union** of two refinements
  into one list.
* **A model** (`Mod`) is an assignment of leaves to the qualified names,
  every proof the canonical one, the default off the keys
  (`Normalized`), under which every piece has a covered model reading
  its leaves through its resolution (`PiecesOk`).  **Restriction** along
  `Ref P ρ Q` is the assignment `G ∘ ρ`, normalized: functorial by
  construction; that its pieces have models is `Ref.pieces`, by
  induction over the refinement, where a reading is `CtxSrc.ctxModel`.
* **Acceptance** (`Accepts`) is `AcceptedFrom` from a one-piece context
  to a one-piece own environment of the same resolution, injective on
  the own names, with every new name resolved to a proof flagged; **the
  step** is `acceptedFrom_model`.
* **Amalgamation** appends the renamed piece (`glue`); the new keys read
  the new model's leaves, the old ones the world's, and where both
  meet — a context key, or a proof key — they agree.
-/

namespace ConLeche.Model.Modular

open ConLeche ConLeche.Modular ConLeche.Model ConLeche.Semantics ConLeche.SetModel
open ConLeche.Term ConLeche.Verify SetTheory

universe w

/-! ## Environments over qualified names -/

/-- **A piece**: a con-leche environment with its resolution of names to
qualified names. -/
structure Piece where
  env : Env
  res : Name → Key

/-- **An environment over qualified names**: a list of pieces. -/
abbrev PEnv := List Piece

/-- The piece that stores nothing. -/
@[expose] def Piece.empty : Piece := ⟨⟨[], []⟩, fun n => .qual 0 n⟩

/-- A piece with its keys renamed. -/
@[expose] def Piece.rename (ρ : Key → Key) (p : Piece) : Piece := ⟨p.env, ρ ∘ p.res⟩

/-- **The keys** of an environment over qualified names. -/
@[expose] def PEnv.HasKey (X : PEnv) (k : Key) : Prop :=
  ∃ p ∈ X, ∃ n, (p.env.find? n).isSome = true ∧ p.res n = k

/-- Is a key a proof's. -/
@[expose] def _root_.ConLeche.Modular.Key.isProof : Key → Bool
  | .proof .. => true
  | .qual .. => false

/-- **The part of piece `q` that piece `p` reads as `q` does.** -/
@[expose] def readsAlikeP (p q : Piece) : Env :=
  ⟨q.env.consts.filter fun c => (p.env.find? c.name).isSome && p.res c.name == q.res c.name, []⟩

/-- **A piece reads from a list of pieces**: each name from a source piece
of the list (or from nothing), as `CtxRead` says. -/
@[expose] def PieceReads (p : Piece) (Q : PEnv) : Prop :=
  ∃ src : Name → Piece, (∀ n, src n ∈ Q ∨ src n = Piece.empty) ∧
    CtxRead p.env (fun n => (src n).env) (fun n => readsAlikeP p (src n))

/-- **A renaming of the keys** of a list that keeps which are proofs'. -/
@[expose] def KeyMap (ρ : Key → Key) (P : PEnv) : Prop :=
  ∀ k, PEnv.HasKey P k → (ρ k).isProof = k.isProof

/-- **Refinement with renaming** (see the module docstring). -/
inductive Ref : PEnv → (Key → Key) → PEnv → Prop
  | reads {P Q : PEnv} : (∀ p ∈ P, PieceReads p Q) → Ref P id Q
  | ren {P : PEnv} {ρ : Key → Key} : KeyMap ρ P → Ref P ρ (P.map (Piece.rename ρ))
  | sub {P Q : PEnv} : (∀ p ∈ P, p ∈ Q) → Ref P id Q
  | union {P P' Q : PEnv} {ρ : Key → Key} : Ref P ρ Q → Ref P' ρ Q → Ref (P ++ P') ρ Q
  | trans {P Q R : PEnv} {ρ σ : Key → Key} : Ref P ρ Q → Ref Q σ R → Ref P (σ ∘ ρ) R

theorem find?_filter_name {l : List ConstantInfo} {p : Name → Bool} {n : Name} :
    (l.filter fun c => p c.name).find? (·.name == n) =
      if p n = true then l.find? (·.name == n) else none := by
  induction l with
  | nil => simp
  | cons c l ih =>
    by_cases hp : p c.name = true <;> by_cases hc : c.name = n <;>
      simp_all

theorem readsAlikeP_find? {p q : Piece} {d : Name} {ci : ConstantInfo}
    (h : (readsAlikeP p q).find? d = some ci) :
    q.env.find? d = some ci ∧ (p.env.find? d).isSome = true ∧ p.res d = q.res d := by
  have h' : List.find? (·.name == d) (q.env.consts.filter fun c =>
      (p.env.find? c.name).isSome && p.res c.name == q.res c.name) = some ci := h
  rw [find?_filter_name (p := fun x => (p.env.find? x).isSome && p.res x == q.res x)] at h'
  split at h'
  · rename_i hp
    simp only [Bool.and_eq_true, beq_iff_eq] at hp
    exact ⟨h', hp.1, hp.2⟩
  · exact nomatch h'

theorem PEnv.hasKey_map {P : PEnv} {ρ : Key → Key} {k : Key} :
    PEnv.HasKey (P.map (Piece.rename ρ)) k ↔ ∃ k', PEnv.HasKey P k' ∧ ρ k' = k := by
  constructor
  · rintro ⟨p', hp', n, hn, rfl⟩
    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hp'
    exact ⟨p.res n, ⟨p, hp, n, hn, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨p, hp, n, hn, rfl⟩, rfl⟩
    exact ⟨p.rename ρ, List.mem_map.mpr ⟨p, hp, rfl⟩, n, hn, rfl⟩

theorem PEnv.hasKey_append {P Q : PEnv} {k : Key} :
    PEnv.HasKey (P ++ Q) k ↔ PEnv.HasKey P k ∨ PEnv.HasKey Q k := by
  constructor
  · rintro ⟨p, hp, n, hn, rfl⟩
    rcases List.mem_append.mp hp with hp | hp
    · exact Or.inl ⟨p, hp, n, hn, rfl⟩
    · exact Or.inr ⟨p, hp, n, hn, rfl⟩
  · rintro (⟨p, hp, n, hn, rfl⟩ | ⟨p, hp, n, hn, rfl⟩)
    · exact ⟨p, List.mem_append_left _ hp, n, hn, rfl⟩
    · exact ⟨p, List.mem_append_right _ hp, n, hn, rfl⟩

/-- **A refinement sends keys to keys**, keeping which are proofs'. -/
theorem Ref.keys {P Q : PEnv} {ρ : Key → Key} (h : Ref P ρ Q) :
    ∀ k, PEnv.HasKey P k → PEnv.HasKey Q (ρ k) ∧ (ρ k).isProof = k.isProof := by
  induction h with
  | @reads P Q hr =>
    rintro _ ⟨p, hp, n, hn, rfl⟩
    obtain ⟨src, hsrc, hrd⟩ := hr p hp
    obtain ⟨ci, hci⟩ := Option.isSome_iff_exists.mp (hrd.self n hn)
    obtain ⟨h1, -, h3⟩ := readsAlikeP_find? hci
    rcases hsrc n with hq | he
    · exact ⟨⟨src n, hq, n, by rw [h1]; rfl, h3.symm⟩, rfl⟩
    · rw [he] at hci; exact nomatch hci
  | @ren P ρ hk =>
    intro k hkP
    exact ⟨PEnv.hasKey_map.mpr ⟨k, hkP, rfl⟩, hk k hkP⟩
  | @sub P Q hs =>
    rintro _ ⟨p, hp, n, hn, rfl⟩
    exact ⟨⟨p, hs p hp, n, hn, rfl⟩, rfl⟩
  | union _ _ ih₁ ih₂ =>
    intro k hk
    rcases PEnv.hasKey_append.mp hk with hk | hk
    · exact ih₁ k hk
    · exact ih₂ k hk
  | trans _ _ ih₁ ih₂ =>
    intro k hk
    obtain ⟨h1, h2⟩ := ih₁ k hk
    obtain ⟨h3, h4⟩ := ih₂ _ h1
    exact ⟨h3, h4.trans h2⟩

/-! ## Models -/

variable (V : Type w) [SetTheory V] (μ : CheckMode)

/-- **A world of leaves**: closed, graded, every proof the canonical one. -/
@[expose] def WorldOk (W : Key → (Name → Nat) → Term) : Prop :=
  (∀ k ψ, Term.Closed (W k ψ)) ∧ (∀ k ψ (ρ : Nat → V), WellDenoted V ρ (W k ψ)) ∧
    ∀ n lps T, W (.proof n lps T) = fun _ => .prf

/-- Leaves that are closed and graded. -/
@[expose] def LeavesOk (W : Key → (Name → Nat) → Term) : Prop :=
  (∀ k ψ, Term.Closed (W k ψ)) ∧ ∀ k ψ (ρ : Nat → V), WellDenoted V ρ (W k ψ)

/-- **Every piece has a covered model** reading its leaves through its
resolution. -/
@[expose] def PiecesOk (X : PEnv) (G : Key → (Name → Nat) → Term) : Prop :=
  ∀ p ∈ X, ∃ mp : EnvModelM V μ p.env, LfpCover mp [] ∧ ConLeche.EtaFamiliesClosed p.env ∧
    NodupNames p.env ∧ ∀ n, (p.env.find? n).isSome = true → mp.base2.acval n = G (p.res n)

/-- The default leaf, off the keys. -/
@[expose] def dfltLeaf : (Name → Nat) → Term := fun _ => .prf

/-- The assignment is the default off the keys. -/
@[expose] def Normalized (X : PEnv) (G : Key → (Name → Nat) → Term) : Prop :=
  ∀ k, ¬ PEnv.HasKey X k → G k = dfltLeaf

/-- **A model of an environment over qualified names** (see the module
docstring). -/
@[expose] def PMod (X : PEnv) : Type :=
  { G : Key → (Name → Nat) → Term // Normalized X G ∧ WorldOk V G ∧ PiecesOk V μ X G }

open Classical in
/-- The assignment, normalized off the keys. -/
@[expose] noncomputable def normalize (X : PEnv) (G : Key → (Name → Nat) → Term) :
    Key → (Name → Nat) → Term :=
  fun k => if PEnv.HasKey X k then G k else dfltLeaf

variable {V μ}

theorem normalize_pos {X : PEnv} {G : Key → (Name → Nat) → Term} {k : Key} (h : PEnv.HasKey X k) :
    normalize X G k = G k := by
  simp only [normalize, h, ↓reduceIte]

theorem normalize_neg {X : PEnv} {G : Key → (Name → Nat) → Term} {k : Key} (h : ¬ PEnv.HasKey X k) :
    normalize X G k = dfltLeaf := by
  simp only [normalize, h, ↓reduceIte]

theorem normalize_normalized (X : PEnv) (G : Key → (Name → Nat) → Term) :
    Normalized X (normalize X G) := fun _ h => normalize_neg h

theorem normalize_of_normalized {X : PEnv} {G : Key → (Name → Nat) → Term}
    (h : Normalized X G) : normalize X G = G := by
  funext k
  by_cases hk : PEnv.HasKey X k
  · exact normalize_pos hk
  · rw [normalize_neg hk, h k hk]

theorem dfltLeaf_closed (ψ : Name → Nat) : Term.Closed (dfltLeaf ψ) := by
  simp [dfltLeaf, Term.Closed, Term.bvarsBelow]

theorem dfltLeaf_wd (ψ : Name → Nat) (ρ : Nat → V) : WellDenoted V ρ (dfltLeaf ψ) := by
  simp [dfltLeaf]

theorem WorldOk.leaves {G : Key → (Name → Nat) → Term} (h : WorldOk V G) : LeavesOk V G :=
  ⟨h.1, h.2.1⟩

theorem LeavesOk.comp {G : Key → (Name → Nat) → Term} (h : LeavesOk V G) (ρ : Key → Key) :
    LeavesOk V (G ∘ ρ) :=
  ⟨fun k ψ => h.1 (ρ k) ψ, fun k ψ r => h.2 (ρ k) ψ r⟩

theorem WorldOk.proof {G : Key → (Name → Nat) → Term} (h : WorldOk V G) {k : Key}
    (hk : k.isProof = true) : G k = dfltLeaf := by
  cases k with
  | proof n lps T => exact h.2.2 n lps T
  | qual _ _ => exact nomatch hk

/-- **The normalized restriction of a world is a world**, along a map of
the keys that keeps which are proofs'. -/
theorem WorldOk.normalize {X : PEnv} {G : Key → (Name → Nat) → Term} (h : WorldOk V G)
    (ρ : Key → Key) (hρ : ∀ k, PEnv.HasKey X k → (ρ k).isProof = k.isProof) :
    WorldOk V (normalize X (G ∘ ρ)) := by
  refine ⟨fun k ψ => ?_, fun k ψ r => ?_, fun n lps T => ?_⟩
  · by_cases hk : PEnv.HasKey X k
    · rw [normalize_pos hk]; exact h.1 _ ψ
    · rw [normalize_neg hk]; exact dfltLeaf_closed ψ
  · by_cases hk : PEnv.HasKey X k
    · rw [normalize_pos hk]; exact h.2.1 _ ψ r
    · rw [normalize_neg hk]; exact dfltLeaf_wd ψ r
  · by_cases hk : PEnv.HasKey X (.proof n lps T)
    · rw [normalize_pos hk]
      exact h.proof (by rw [hρ _ hk]; rfl)
    · rw [normalize_neg hk]; rfl

theorem PiecesOk.congr {X : PEnv} {G G' : Key → (Name → Nat) → Term} (h : PiecesOk V μ X G)
    (hG : ∀ k, PEnv.HasKey X k → G k = G' k) : PiecesOk V μ X G' := by
  intro p hp
  obtain ⟨mp, h1, h2, h3, h4⟩ := h p hp
  exact ⟨mp, h1, h2, h3, fun n hn => (h4 n hn).trans (hG _ ⟨p, hp, n, hn, rfl⟩)⟩

/-- **A reading has models**: a piece that reads from pieces with models
has one (`CtxSrc.ctxModel`). -/
theorem PieceReads.model {p : Piece} {Q : PEnv} (hr : PieceReads p Q)
    {G : Key → (Name → Nat) → Term} (hG : LeavesOk V G) (hQ : PiecesOk V μ Q G) :
    ∃ mp : EnvModelM V μ p.env, LfpCover mp [] ∧ ConLeche.EtaFamiliesClosed p.env ∧
      NodupNames p.env ∧ ∀ n, (p.env.find? n).isSome = true → mp.base2.acval n = G (p.res n) := by
  classical
  obtain ⟨src, hsrc, hrd⟩ := hr
  let srcOf : Name → Σ E : Env, EnvModelM V μ E := fun n =>
    if h : src n ∈ Q then ⟨(src n).env, Classical.choose (hQ _ h)⟩
    else ⟨Env.empty, EnvModelM.empty V μ⟩
  have hpos : ∀ n (h : src n ∈ Q), srcOf n = ⟨(src n).env, Classical.choose (hQ _ h)⟩ :=
    fun n h => by simp only [srcOf, h, ↓reduceDIte]
  have hneg : ∀ n, src n ∉ Q → srcOf n = ⟨Env.empty, EnvModelM.empty V μ⟩ :=
    fun n h => by simp only [srcOf, h, ↓reduceDIte]
  have hE : (fun n => (srcOf n).1) = fun n => (src n).env := by
    funext n
    by_cases h : src n ∈ Q
    · rw [hpos n h]
    · rw [hneg n h, (hsrc n).resolve_left h]; rfl
  let S : CtxSrc V μ p.env (fun n => G (p.res n)) :=
    { E := fun n => (srcOf n).1
      m := fun n => (srcOf n).2
      R := fun n => readsAlikeP p (src n)
      read := hE ▸ hrd
      leafEq := fun n _ d hR hEd => by
        by_cases h : src n ∈ Q
        · rw [hpos n h]
          obtain ⟨ci, hci⟩ := Option.isSome_iff_exists.mp hR
          obtain ⟨h1, -, h3⟩ := readsAlikeP_find? hci
          have := (Classical.choose_spec (hQ _ h)).2.2.2 d (by rw [h1]; rfl)
          show G (p.res d) = _
          rw [this, h3]
        · rw [(hsrc n).resolve_left h] at hR; exact nomatch hR
      cover := fun n => by
        by_cases h : src n ∈ Q
        · rw [hpos n h]; exact (Classical.choose_spec (hQ _ h)).1
        · rw [hneg n h]; exact lfpCover_empty
      eta := fun n => by
        by_cases h : src n ∈ Q
        · rw [hpos n h]; exact (Classical.choose_spec (hQ _ h)).2.1
        · rw [hneg n h]; exact ConLeche.EtaFamiliesClosed.empty
      closed := fun n ψ => hG.1 _ ψ
      wd := fun n ψ r => hG.2 _ ψ r }
  obtain ⟨mc, hmc, hcov, heta⟩ := S.ctxModel
  exact ⟨mc, hcov, heta, hrd.nodup, fun n _ => by rw [hmc]⟩

/-- **Restriction has models**: along a refinement, the pieces of the
smaller list have models at the restricted leaves. -/
theorem Ref.pieces {P Q : PEnv} {ρ : Key → Key} (h : Ref P ρ Q) :
    ∀ G, LeavesOk V G → PiecesOk V μ Q G → PiecesOk V μ P (G ∘ ρ) := by
  induction h with
  | reads hr => exact fun G hG hQ p hp => (hr p hp).model hG hQ
  | @ren P ρ _ =>
    intro G _ hQ p hp
    exact hQ (p.rename ρ) (List.mem_map.mpr ⟨p, hp, rfl⟩)
  | sub hs => exact fun G _ hQ p hp => hQ p (hs p hp)
  | union _ _ ih₁ ih₂ =>
    intro G hG hQ p hp
    rcases List.mem_append.mp hp with hp | hp
    · exact ih₁ G hG hQ p hp
    · exact ih₂ G hG hQ p hp
  | @trans P Q R ρ σ _ _ ih₁ ih₂ =>
    intro G hG hR
    exact ih₁ (G ∘ σ) (hG.comp σ) (ih₂ G hG hR)

/-- **Restriction** along a refinement. -/
@[expose] noncomputable def restrictP {P Q : PEnv} {ρ : Key → Key} (h : Ref P ρ Q)
    (m : PMod V μ Q) : PMod V μ P :=
  ⟨normalize P (m.1 ∘ ρ), normalize_normalized _ _,
    WorldOk.normalize m.2.2.1 ρ fun k hk => (h.keys k hk).2,
    PiecesOk.congr (h.pieces _ (WorldOk.leaves m.2.2.1) m.2.2.2) fun _ hk => (normalize_pos hk).symm⟩

theorem restrictP_id {E : PEnv} (m : PMod V μ E) : restrictP (Ref.sub fun _ h => h) m = m :=
  Subtype.ext (normalize_of_normalized m.2.1)

theorem restrictP_comp {P Q R : PEnv} {ρ σ : Key → Key} (h₁ : Ref P ρ Q) (h₂ : Ref Q σ R)
    (m : PMod V μ R) : restrictP (Ref.trans h₁ h₂) m = restrictP h₁ (restrictP h₂ m) := by
  apply Subtype.ext
  funext k
  show normalize P (m.1 ∘ (σ ∘ ρ)) k = normalize P (normalize Q (m.1 ∘ σ) ∘ ρ) k
  by_cases hk : PEnv.HasKey P k
  · rw [normalize_pos hk, normalize_pos hk]
    show m.1 (σ (ρ k)) = normalize Q (m.1 ∘ σ) (ρ k)
    rw [normalize_pos (h₁.keys k hk).1]; rfl
  · rw [normalize_neg hk, normalize_neg hk]

/-! ## Acceptance and the step -/

variable (μ) in
/-- **Acceptance** (see the module docstring). -/
@[expose] def AcceptsP (pins : List NatOpPinSet) (Γ : PEnv) (D : List Declaration × (Name → Bool))
    (Γ' : PEnv) : Prop :=
  ∃ C E' r, Γ = [⟨C, r⟩] ∧ Γ' = [⟨E', r⟩] ∧ AcceptedFrom μ pins D.2 C D.1 E' ∧
    PieceReads ⟨C, r⟩ [⟨E', r⟩] ∧
    (∀ n n', (E'.find? n).isSome = true → (E'.find? n').isSome = true → r n = r n' → n = n') ∧
    ∀ n, (E'.find? n).isSome = true → C.find? n = none → (r n).isProof = true → D.2 n = true

theorem AcceptsP.ref {pins : List NatOpPinSet} {Γ Γ' : PEnv} {D : List Declaration × (Name → Bool)}
    (h : AcceptsP μ pins Γ D Γ') : Ref Γ id Γ' := by
  obtain ⟨C, E', r, rfl, rfl, -, hr, -⟩ := h
  exact Ref.reads fun p hp => by rw [List.mem_singleton.mp hp]; exact hr

theorem hasKey_single {E : Env} {r : Name → Key} {k : Key} :
    PEnv.HasKey [⟨E, r⟩] k ↔ ∃ n, (E.find? n).isSome = true ∧ r n = k := by
  constructor
  · rintro ⟨p, hp, n, hn, rfl⟩
    rw [List.mem_singleton.mp hp] at hn ⊢
    exact ⟨n, hn, rfl⟩
  · rintro ⟨n, hn, rfl⟩
    exact ⟨_, List.mem_singleton_self _, n, hn, rfl⟩

/-- **The conservative step.** -/
theorem stepP (hμ : μ.isVerified = true) {pins : List NatOpPinSet} {Γ Γ' : PEnv}
    {D : List Declaration × (Name → Bool)} (h : AcceptsP μ pins Γ D Γ') (m : PMod V μ Γ) :
    ∃ m' : PMod V μ Γ', restrictP h.ref m' = m := by
  classical
  obtain ⟨C, E', r, rfl, rfl, hacc, hrd, hinj, hpf⟩ := h
  obtain ⟨G, hnG, hwG, hpG⟩ := m
  obtain ⟨mc, hcov, heta, hnd, hlc⟩ := hpG ⟨C, r⟩ (List.mem_singleton_self _)
  obtain ⟨hnd', hext, -⟩ := acceptedFrom_syn hacc hnd
  obtain ⟨mp, hag, hcov', heta', hfl⟩ := acceptedFrom_model hμ hacc mc hcov heta hnd
  let G' : Key → (Name → Nat) → Term := fun k =>
    if h : ∃ n, (E'.find? n).isSome = true ∧ r n = k then mp.base2.acval (Classical.choose h)
    else dfltLeaf
  have hG' : ∀ n, (E'.find? n).isSome = true → G' (r n) = mp.base2.acval n := by
    intro n hn
    have h : ∃ n', (E'.find? n').isSome = true ∧ r n' = r n := ⟨n, hn, rfl⟩
    simp only [G', h, ↓reduceDIte]
    obtain ⟨h1, h2⟩ := Classical.choose_spec h
    rw [hinj _ _ h1 hn h2]
  have hold : ∀ n, (C.find? n).isSome = true → G' (r n) = G (r n) := by
    intro n hn
    obtain ⟨ci, hci⟩ := Option.isSome_iff_exists.mp hn
    have hE : (E'.find? n).isSome = true := by rw [hext.find? hnd' hci]; rfl
    rw [hG' n hE, (hag n hn).2, hlc n hn]
  refine ⟨⟨G', fun k hk => ?_, ⟨fun k ψ => ?_, fun k ψ ρ => ?_, fun n lps T => ?_⟩,
    fun p hp => ?_⟩, ?_⟩
  · have : ¬ ∃ n, (E'.find? n).isSome = true ∧ r n = k := fun h => hk (hasKey_single.mpr h)
    simp only [G', this, ↓reduceDIte]
  · by_cases h : ∃ n, (E'.find? n).isSome = true ∧ r n = k
    · simp only [G', h, ↓reduceDIte]; exact mp.base2.cval_closed _ ψ
    · simp only [G', h, ↓reduceDIte]; exact dfltLeaf_closed ψ
  · by_cases h : ∃ n, (E'.find? n).isSome = true ∧ r n = k
    · simp only [G', h, ↓reduceDIte]; exact mp.base2.acval_wellDenoted _ ψ ρ
    · simp only [G', h, ↓reduceDIte]; exact dfltLeaf_wd ψ ρ
  · by_cases h : ∃ n', (E'.find? n').isSome = true ∧ r n' = .proof n lps T
    · obtain ⟨n', hn', hk⟩ := h
      rw [← hk, hG' n' hn']
      cases hc : C.find? n' with
      | some ci =>
        have hcs : (C.find? n').isSome = true := by rw [hc]; rfl
        rw [(hag n' hcs).2, hlc n' hcs]
        show G (r n') = _
        rw [hk]
        exact hwG.2.2 n lps T
      | none => exact hfl n' (hpf n' hn' hc (by rw [hk]; rfl)) hc hn'
    · simp only [G', h, ↓reduceDIte]; rfl
  · rw [List.mem_singleton.mp hp]
    exact ⟨mp, hcov', heta', hnd', fun n hn => (hG' n hn).symm⟩
  · apply Subtype.ext
    funext k
    show normalize [⟨C, r⟩] (G' ∘ id) k = G k
    by_cases hk : PEnv.HasKey [⟨C, r⟩] k
    · rw [normalize_pos hk]
      obtain ⟨n, hn, rfl⟩ := hasKey_single.mp hk
      exact hold n hn
    · rw [normalize_neg hk, hnG k hk]

/-! ## Freshness and amalgamation -/

/-- **Freshness**: the renaming is injective on the keys of `Γ'` and keeps
which are proofs', and a key `Γ'` adds to `Γ` that is already in `W`
after renaming is a proof's. -/
@[expose] def FreshP (W : PEnv) (ρ : Key → Key) (Γ Γ' : PEnv) : Prop :=
  (∀ k k', PEnv.HasKey Γ' k → PEnv.HasKey Γ' k' → ρ k = ρ k' → k = k') ∧ KeyMap ρ Γ' ∧
    ∀ k, PEnv.HasKey Γ' k → ¬ PEnv.HasKey Γ k → PEnv.HasKey W (ρ k) → k.isProof = true

/-- **`W` with `Γ'`, renamed.** -/
@[expose] def glueP (W : PEnv) (ρ : Key → Key) (Γ' : PEnv) : PEnv := W ++ Γ'.map (Piece.rename ρ)

theorem glueP_left {W Γ' : PEnv} {ρ : Key → Key} : Ref W id (glueP W ρ Γ') :=
  Ref.sub fun _ h => List.mem_append_left _ h

theorem glueP_right {W Γ' : PEnv} {ρ : Key → Key} (f : KeyMap ρ Γ') : Ref Γ' ρ (glueP W ρ Γ') :=
  Ref.trans (ρ := ρ) (σ := id) (Ref.ren f) (Ref.sub fun _ h => List.mem_append_right _ h)

/-- **Amalgamation.** -/
theorem amalgamateP {pins : List NatOpPinSet} {Γ Γ' W : PEnv} {D : List Declaration × (Name → Bool)}
    {ρ : Key → Key} (r : Ref Γ ρ W) (a : AcceptsP μ pins Γ D Γ') (f : FreshP W ρ Γ Γ')
    (mW : PMod V μ W) (m' : PMod V μ Γ') (heq : restrictP r mW = restrictP a.ref m') :
    ∃ m'' : PMod V μ (glueP W ρ Γ'), restrictP glueP_left m'' = mW ∧
      restrictP (glueP_right f.2.1) m'' = m' := by
  classical
  obtain ⟨finj, fkey, fnew⟩ := f
  obtain ⟨G, hnG, hwG, hpG⟩ := mW
  obtain ⟨G', hnG', hwG', hpG'⟩ := m'
  have hagree : ∀ k, PEnv.HasKey Γ k → G (ρ k) = G' k := by
    intro k hk
    have := congrFun (congrArg Subtype.val heq) k
    change normalize Γ (G ∘ ρ) k = normalize Γ (G' ∘ id) k at this
    rw [normalize_pos hk, normalize_pos hk] at this
    exact this
  have hΓsub : ∀ k, PEnv.HasKey Γ k → PEnv.HasKey Γ' k := fun k hk => (a.ref.keys k hk).1
  let G'' : Key → (Name → Nat) → Term := fun k =>
    if PEnv.HasKey W k then G k
    else if h : ∃ k', PEnv.HasKey Γ' k' ∧ ρ k' = k then G' (Classical.choose h) else dfltLeaf
  have hnew : ∀ k', PEnv.HasKey Γ' k' → G'' (ρ k') = G' k' := by
    intro k' hk'
    by_cases hW : PEnv.HasKey W (ρ k')
    · simp only [G'', hW, ↓reduceIte]
      by_cases hΓ : PEnv.HasKey Γ k'
      · exact hagree k' hΓ
      · have hp := fnew k' hk' hΓ hW
        rw [hwG.proof (by rw [fkey k' hk', hp]), hwG'.proof hp]
    · have h : ∃ k'', PEnv.HasKey Γ' k'' ∧ ρ k'' = ρ k' := ⟨k', hk', rfl⟩
      simp only [G'', hW, h, ↓reduceIte, ↓reduceDIte]
      obtain ⟨h1, h2⟩ := Classical.choose_spec h
      rw [finj _ _ h1 hk' h2]
  have hold : ∀ k, PEnv.HasKey W k → G'' k = G k := fun k hk => by simp only [G'', hk, ↓reduceIte]
  refine ⟨⟨G'', fun k hk => ?_, ⟨fun k ψ => ?_, fun k ψ rr => ?_, fun n lps T => ?_⟩,
    fun p hp => ?_⟩, ?_, ?_⟩
  · have hW : ¬ PEnv.HasKey W k := fun h => hk (PEnv.hasKey_append.mpr (Or.inl h))
    have h : ¬ ∃ k', PEnv.HasKey Γ' k' ∧ ρ k' = k := fun h =>
      hk (PEnv.hasKey_append.mpr (Or.inr (PEnv.hasKey_map.mpr h)))
    simp only [G'', hW, h, ↓reduceIte, ↓reduceDIte]
  · by_cases hW : PEnv.HasKey W k
    · rw [hold k hW]; exact hwG.1 _ ψ
    · by_cases h : ∃ k', PEnv.HasKey Γ' k' ∧ ρ k' = k
      · simp only [G'', hW, h, ↓reduceIte, ↓reduceDIte]; exact hwG'.1 _ ψ
      · simp only [G'', hW, h, ↓reduceIte, ↓reduceDIte]; exact dfltLeaf_closed ψ
  · by_cases hW : PEnv.HasKey W k
    · rw [hold k hW]; exact hwG.2.1 _ ψ rr
    · by_cases h : ∃ k', PEnv.HasKey Γ' k' ∧ ρ k' = k
      · simp only [G'', hW, h, ↓reduceIte, ↓reduceDIte]; exact hwG'.2.1 _ ψ rr
      · simp only [G'', hW, h, ↓reduceIte, ↓reduceDIte]; exact dfltLeaf_wd ψ rr
  · by_cases hW : PEnv.HasKey W (.proof n lps T)
    · rw [hold _ hW]; exact hwG.2.2 n lps T
    · by_cases h : ∃ k', PEnv.HasKey Γ' k' ∧ ρ k' = .proof n lps T
      · obtain ⟨k', hk', hρ⟩ := h
        rw [← hρ, hnew k' hk']
        exact hwG'.proof (by rw [← fkey k' hk', hρ]; rfl)
      · simp only [G'', hW, h, ↓reduceIte, ↓reduceDIte]; rfl
  · rcases List.mem_append.mp hp with hp | hp
    · exact (hpG p hp).imp fun mp ⟨h1, h2, h3, h4⟩ =>
        ⟨h1, h2, h3, fun n hn => (h4 n hn).trans (hold _ ⟨p, hp, n, hn, rfl⟩).symm⟩
    · obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hp
      exact (hpG' q hq).imp fun mp ⟨h1, h2, h3, h4⟩ =>
        ⟨h1, h2, h3, fun n hn => (h4 n hn).trans (hnew _ ⟨q, hq, n, hn, rfl⟩).symm⟩
  · apply Subtype.ext
    funext k
    show normalize W (G'' ∘ id) k = G k
    by_cases hk : PEnv.HasKey W k
    · rw [normalize_pos hk]; exact hold k hk
    · rw [normalize_neg hk, hnG k hk]
  · apply Subtype.ext
    funext k
    show normalize Γ' (G'' ∘ (id ∘ ρ)) k = G' k
    by_cases hk : PEnv.HasKey Γ' k
    · rw [normalize_pos hk]; exact hnew k hk
    · rw [normalize_neg hk, hnG' k hk]

/-! ## The instance -/

/-- The base: nothing, with the default leaves. -/
@[expose] def baseModelP : PMod V μ [] :=
  ⟨fun _ => dfltLeaf, fun _ _ => rfl,
    ⟨fun _ ψ => dfltLeaf_closed ψ, fun _ ψ r => dfltLeaf_wd ψ r, fun _ _ _ => rfl⟩,
    fun _ h => nomatch h⟩

variable (V μ) in
/-- **Con-leche's models as a modular semantics.** -/
@[expose] noncomputable def conlecheSemantics (hμ : μ.isVerified = true) (pins : List NatOpPinSet) :
    ModularSemantics.{0, 0} where
  Env := PEnv
  Name := Key
  Refines := Ref
  refines_id _ := Ref.sub fun _ h => h
  refines_comp := Ref.trans
  Mod := PMod V μ
  restrict := restrictP
  restrict_id := restrictP_id
  restrict_comp := restrictP_comp
  Decls := List Declaration × (Name → Bool)
  Accepts := AcceptsP μ pins
  accepts_refines := AcceptsP.ref
  step := stepP hμ
  Fresh := FreshP
  glue := glueP
  glue_left := glueP_left
  glue_right := fun _ _ f => glueP_right f.2.1
  amalgamate := amalgamateP
  base := []
  baseModel := baseModelP

end ConLeche.Model.Modular
