module

public import ConLeche.Verify.BoostRed.BoostKit
public meta import Lean
public meta import ConLeche.PinGen
public meta import ConLeche.PinGen.BoostPins

/-!
# Boost: the boost translation (task #367, used by #368)

`#boost F` relates the checker's deep embedding of `F` (`Red` on the
checker's `Expr`) to Lean's shallow `F` by a **parametricity-style
translation of the shallow kernel term**, generated by structural
recursion over the term.  Nothing is tried: no reduction until stuck,
no fact matching, no search; every proof step is determined by the
syntax of the term being translated.

**Types.** For a shallow type `A` the relation is fixed by `A`'s shape:

* a proposition: none (proofs are not translated);
* a data type: `Expr → A → Prop`, the relation of `A`'s *type-term
  translation* `[[A]] : SatRel env d A` (saturated: closed under
  backward `Red`);
* `Π x : A, B` at data codomain: `[[Π]] fd f := ∀ xd, closed xd → ∀ x,
  [[A]] xd x → [[B]] (app fd xd) (f x)` (no relation for a proof
  binder; relation *data* for a type binder);
* `Sort u`, and type families: relation *data*, deep-free (a type's
  relation does not depend on a deep term).

**Terms.** For `t : A` (data), `[[t]] : [[A]] (D t) t` where `D t` is
the deep counterpart: `substS σ (enc t) 0`, `σ` the deep variables of the
entered binders.  Variable: its context entry.  Application: the head's
relation applied to the argument's deep counterpart, its closedness, the
argument, and the argument's relation.  Abstraction: introduce
`xd hxd x xR`, then `sat` along `Red.betaS`.  Literal: `natLit_R`.
Projection: the structure's field lemma.  Constant: its own lemma.

**Constants**, one lemma per constant instance (levels and the element
classes of its type binders), generated once and reused by name:

* definition: `sat` along δ, then the translation of its body;
* inductive type: its relation, by its own recursor (`SatOf` of a core
  saying "reduces to a constructor with related fields");
* constructor: by that definition;
* recursor: by the shallow recursor's own induction principle, with deep
  ι (`Red.iota2`, β by `Red.betaSpine`) in each case (a K-like
  recursor, `Eq.rec`, by `Red.kRec`; `Acc.rec` is not translated);
* at a type-valued motive (`Nat.below`'s `Nat.rec`): the shallow
  recursor alone (types' relations are deep-free);
* `Nat`, `Bool` and the `natOp` operations: the fixed primitives of
  `BoostKit`.

Each data lemma is `∀ env d, pins → callee lemmas → Good env d`; the
final theorem assembles them once each.
-/

public meta section

namespace BoostGen

open Lean Meta Elab Term Command
open ConLeche.PinGen.Boost (pinNS clExprT clLevelT liftExcept ensurePinData)

/-- Add a generated declaration (not compiled: the relations and lemmas
are proof data). -/
def splice (declName : Lean.Name) (ty value : Lean.Expr) : TermElabM Unit := do
  let hints : Lean.ReducibilityHints := .regular (getMaxHeight (← getEnv) value + 1)
  let decl : Lean.Declaration := .defnDecl
    (← mkDefinitionValInferringUnsafe declName [] ty value hints)
  withExporting (isExporting := true) do
    addDecl decl (forceExpose := true)

/-! ## Names and quoting -/

def kitN (s : String) : Name := (s.splitOn ".").foldl Name.str `ConLeche.Rules.BoostRed
def redN (s : String) : Name := (`ConLeche.Rules.Red).str s
def instNS : Name := `BoostLem

def qApp (f a : Expr) : Expr := mkApp2 (Lean.mkConst ``ConLeche.Expr.app) f a
def qAppN (f : Expr) (args : List Expr) : Expr := args.foldl qApp f
def qList (ty : Expr) (xs : List Expr) : Expr :=
  xs.foldr (fun x acc => mkApp3 (Lean.mkConst ``List.cons [.zero]) ty x acc)
    (mkApp (Lean.mkConst ``List.nil [.zero]) ty)
def qConstE (n us : Expr) : Expr := mkApp2 (Lean.mkConst ``ConLeche.Expr.const) n us
def qMkAppN (f : Expr) (args : List Expr) : Expr :=
  mkApp2 (Lean.mkConst ``ConLeche.Expr.mkAppN) f (qList clExprT args)
def qSubstS (σ q : Expr) : Expr := mkApp3 (Lean.mkConst (kitN "substS")) σ q (mkRawNatLit 0)
def mkClosedTy (y : Expr) : Expr :=
  mkApp3 (Lean.mkConst ``Eq [1]) (Lean.mkConst ``Bool)
    (mkApp2 (Lean.mkConst ``ConLeche.Expr.looseBVarsBounded) (mkRawNatLit 0) y) (Lean.mkConst ``Bool.true)
def eqRefl (ty a : Expr) (u : Level := 1) : Expr := mkApp2 (Lean.mkConst ``Eq.refl [u]) ty a
def boolRefl (b : Bool) : Expr := eqRefl (Lean.mkConst ``Bool) (toExpr b)

/-- A quoted deep term's shape. -/
inductive DV where
  | bvar (i : Nat)
  | app (f a : Expr)
  | lam (t b : Expr)
  | forallE (t b : Expr)
  | const (n us : Expr)
  | lit (l : Expr)
  | letE (t v b : Expr)
  | proj (s i e : Expr)
  | sort (u : Expr)
  | other

def dview (q : Expr) : DV :=
  let a := q.getAppArgs
  match q.getAppFn.constName? with
  | some ``ConLeche.Expr.bvar => match a[0]! with | .lit (.natVal i) => .bvar i | _ => .other
  | some ``ConLeche.Expr.app => .app a[0]! a[1]!
  | some ``ConLeche.Expr.lam => .lam a[0]! a[1]!
  | some ``ConLeche.Expr.forallE => .forallE a[0]! a[1]!
  | some ``ConLeche.Expr.const => .const a[0]! a[1]!
  | some ``ConLeche.Expr.lit => .lit a[0]!
  | some ``ConLeche.Expr.proj => .proj a[0]! a[1]! a[2]!
  | some ``ConLeche.Expr.sort => .sort a[0]!
  | some ``ConLeche.Expr.letE => .letE a[0]! a[1]! a[2]!
  | _ => .other

/-- The spine of a quoted deep application. -/
partial def qSpine (q : Expr) : Expr × Array Expr :=
  match dview q with
  | .app f a => let (h, as) := qSpine f; (h, as.push a)
  | _ => (q, #[])

/-- Decode a quoted checker name. -/
partial def decName (e : Expr) : MetaM ConLeche.Name := do
  match e.getAppFn.constName?, e.getAppArgs with
  | some ``ConLeche.Name.anonymous, _ => return .anonymous
  | some ``ConLeche.Name.str, #[p, .lit (.strVal s)] => return .str (← decName p) s
  | some ``ConLeche.Name.num, #[p, .lit (.natVal n)] => return .num (← decName p) n
  | _, _ => throwError "decName: {e}"

partial def decLevel (e : Expr) : MetaM ConLeche.Level := do
  match e.getAppFn.constName?, e.getAppArgs with
  | some ``ConLeche.Level.zero, _ => return .zero
  | some ``ConLeche.Level.succ, #[u] => return .succ (← decLevel u)
  | some ``ConLeche.Level.max, #[u, v] => return .max (← decLevel u) (← decLevel v)
  | some ``ConLeche.Level.imax, #[u, v] => return .imax (← decLevel u) (← decLevel v)
  | some ``ConLeche.Level.param, #[n] => return .param (← decName n)
  | _, _ => throwError "decLevel: {e}"

partial def decList (e : Expr) : MetaM (List Expr) := do
  match e.getAppFn.constName?, e.getAppArgs with
  | some ``List.nil, _ => return []
  | some ``List.cons, #[_, x, xs] => return x :: (← decList xs)
  | _, _ => throwError "decList: {e}"

/-- A checker level as a Lean level (concrete levels only). -/
partial def toLeanLevel : ConLeche.Level → MetaM Level
  | .zero => return .zero
  | .succ u => return .succ (← toLeanLevel u)
  | .max u v => return .max (← toLeanLevel u) (← toLeanLevel v)
  | .imax u v => return .imax (← toLeanLevel u) (← toLeanLevel v)
  | .param n => throwError "#boost: level parameter {repr n} (concrete levels only)"

def isZeroLevel (u : Level) : MetaM Bool := do
  let u ← instantiateLevelMVars u
  if u.hasParam then throwError "#boost: universe parameter in {u} (concrete levels only)"
  return u.normalize.isZero

/-! ## Classes -/

/-- The element class of a type: data (`D`, a `Prop` relation with a
deep term), or types (`L`, a deep-free relation per element type). -/
inductive EK where | D | L
  deriving BEq, Repr, Inhabited, Hashable

/-- A binder's class: a proof, a proposition/predicate, a type or type
family (with its elements' class), or data. -/
inductive Cls where | prf | prop | ty (k : EK) | dat
  deriving BEq, Repr, Inhabited

structure Ent where
  x : Expr
  cls : Cls
  deep : Option Expr := none
  cl : Option Expr := none
  rel : Option Expr := none
  deriving Inhabited

structure Ctx where
  env : Expr
  d : Expr
  ents : Array Ent := #[]
  /-- the deep variables of the entered binders, innermost first -/
  sigma : Expr
  sigmaLen : Nat := 0
  /-- `AllClosed sigma` -/
  hsigma : Expr
  deriving Inhabited

def Ctx.push (c : Ctx) (e : Ent) : Ctx := { c with ents := c.ents.push e }
def Ctx.find? (c : Ctx) (x : Expr) : Option Ent := c.ents.findRev? (·.x == x)

def Ctx.enterDeep (c : Ctx) (yd hyd : Expr) : Ctx :=
  { c with sigma := mkApp3 (Lean.mkConst ``List.cons [.zero]) clExprT yd c.sigma,
           sigmaLen := c.sigmaLen + 1,
           hsigma := mkApp4 (Lean.mkConst ``And.intro) (mkClosedTy yd)
             (mkApp (Lean.mkConst (kitN "AllClosed")) c.sigma) hyd c.hsigma }

def Ctx.empty (env d : Expr) : Ctx :=
  { env, d, sigma := mkApp (Lean.mkConst ``List.nil [.zero]) clExprT, hsigma := Lean.mkConst ``True.intro }

/-- The class of a binder of type `Y`. -/
def binderCls (ctx : Ctx) (Y : Expr) (κ? : Option EK) : MetaM Cls := do
  let s ← whnf (← inferType Y)
  let .sort u := s | throwError "binderCls: not a type{indentExpr Y}"
  if ← isZeroLevel u then return .prf
  forallTelescopeReducing Y fun _ T => do
    let T ← whnf T
    match T with
    | .sort v => if ← isZeroLevel v then return .prop else return .ty (κ?.getD .D)
    | _ =>
      if let .fvar _ := T.getAppFn then
        if let some e := ctx.find? T.getAppFn then
          if e.cls == .ty .L then return .ty .D
      return .dat

/-- The element class of a type `A` (`none`: proofs or propositions). -/
def elemsEK (ctx : Ctx) (A : Expr) : MetaM (Option EK) := do
  match ← binderCls ctx A none with
  | .ty _ => return some .L
  | .dat => return some .D
  | _ =>
    -- a type in a universe whose elements are propositions/proofs
    return none

/-- The element class of a type(-family) argument. -/
def argEK (ctx : Ctx) (a : Expr) : MetaM EK := do
  forallTelescopeReducing (← inferType a) fun zs _ => do
    return (← elemsEK ctx (mkAppN a zs).headBeta).getD .D

/-- The element classes of a constant's type binders, from its arguments. -/
def inferKappas (ctx : Ctx) (ty : Expr) (args : Array Expr) : MetaM (List EK) := do
  let mut ty := ty
  let mut out : Array EK := #[]
  for a in args do
    let .forallE _ Y B _ ← whnf ty | break
    if let .ty _ ← binderCls ctx Y none then
      out := out.push (← argEK ctx a)
    ty := B.instantiate1 a
  return out.toList

/-- The number of distinct subterms. -/
def dagSize (e : Expr) : Nat := Id.run do
  let mut seen : Std.HashSet Expr := {}
  let mut todo := #[e]
  while !todo.isEmpty do
    let x := todo.back!
    todo := todo.pop
    if seen.contains x then continue
    seen := seen.insert x
    match x with
    | .app f a => todo := todo.push f |>.push a
    | .lam _ t b _ | .forallE _ t b _ => todo := todo.push t |>.push b
    | .letE _ t v b _ => todo := todo.push t |>.push v |>.push b
    | .mdata _ b => todo := todo.push b
    | .proj _ _ b => todo := todo.push b
    | _ => pure ()
  return seen.size

/-! ## The generation monad -/

structure GState where
  hyps : Array (Expr × Expr) := #[]

abbrev GM := StateRefT GState TermElabM

/-- A hypothesis of the lemma being generated (a pin, a fact, a callee's
lemma), as a free variable abstracted at the end. -/
def needHyp (ty : Expr) : GM Expr := do
  let ty ← instantiateMVars ty
  for (t, h) in (← get).hyps do
    if t == ty then return h
  let h := mkFVar (← mkFreshFVarId)
  modify fun s => { s with hyps := s.hyps.push (ty, h) }
  return h

/-! ## The natOp primitives -/

def natOpLemma : Name → Option (Name × Name)
  | ``Nat.add => some (kitN "Nat.add_R", ``ConLeche.natAddName)
  | ``Nat.sub => some (kitN "Nat.sub_R", ``ConLeche.natSubName)
  | ``Nat.mul => some (kitN "Nat.mul_R", ``ConLeche.natMulName)
  | ``Nat.div => some (kitN "Nat.div_R", ``ConLeche.natDivName)
  | ``Nat.mod => some (kitN "Nat.mod_R", ``ConLeche.natModName)
  | ``Nat.beq => some (kitN "Nat.beq_R", ``ConLeche.natBeqName)
  | ``Nat.ble => some (kitN "Nat.ble_R", ``ConLeche.natBleName)
  | _ => none


/-! ## Relations of types -/

/-- The relation data of a type `Z : Sort u` whose elements have class `κ`. -/
def relData (ctx : Ctx) (κ : EK) (Z : Expr) : MetaM Expr := do
  let u ← getLevel Z
  match κ with
  | .D => return mkApp3 (Lean.mkConst (kitN "SatRel") [u]) ctx.env ctx.d Z
  | .L => mkArrow Z (mkSort u)

/-- The relation proofs a recursor case needs about its deep major: the
constructor form, the deep fields, their closedness and relations. -/
structure View where
  hmaj : Expr
  levels : List Expr
  pds : List Expr
  yds : List Expr
  cls : List Expr
  rels : List Expr


mutual

/-- Introduce a Π's binders as a relation statement does: data mode
(`yd hyd y [yR]`, the deep application grows) or type mode (`y [yR]`).
`κs` gives the element classes of the leading type binders.  `k` builds
the body from the extended context, the codomain, the deep and the
shallow application. -/
partial def withBinders (ctx : Ctx) (dataMode : Bool) (close : Array Expr → Expr → MetaM Expr)
    (Y deepE shallowA : Expr) (κs : List EK) (n? : Option Nat)
    (k : Ctx → Expr → Expr → Expr → GM Expr) : GM Expr := do
  if n? == some 0 then return ← k ctx Y deepE shallowA
  let Yw ← whnf Y
  match Yw with
  | .forallE nm Z B bi =>
    let c ← binderCls ctx Z κs.head?
    let κs' := match c with | .ty _ => κs.drop 1 | _ => κs
    let n?' := n?.map (· - 1)
    if dataMode then
      withLocalDeclD (nm.appendAfter "d") clExprT fun yd => do
      withLocalDeclD (nm.appendAfter "_cl") (mkClosedTy yd) fun hyd => do
      withLocalDecl nm bi Z fun y => do
        let rest (yR? : Option Expr) : GM Expr := do
          let ctx' := ctx.push { x := y, cls := c, deep := yd, cl := hyd, rel := yR? }
          let body ← withBinders ctx' dataMode close (B.instantiate1 y) (qApp deepE yd)
            (mkApp shallowA y) κs' n?' k
          close (#[yd, hyd, y] ++ yR?.toArray) body
        match c with
        | .prf | .prop => rest none
        | .ty κ => withLocalDeclD (nm.appendAfter "R") (← relTy ctx Z κ y) fun yR => rest (some yR)
        | .dat => withLocalDeclD (nm.appendAfter "R") (← relD ctx Z yd y) fun yR => rest (some yR)
    else
      withLocalDecl nm bi Z fun y => do
        let rest (yR? : Option Expr) : GM Expr := do
          let ctx' := ctx.push { x := y, cls := c, rel := yR? }
          let body ← withBinders ctx' dataMode close (B.instantiate1 y) deepE
            (mkApp shallowA y) κs' n?' k
          close (#[y] ++ yR?.toArray) body
        match c with
        | .ty κ => withLocalDeclD (nm.appendAfter "R") (← relTy ctx Z κ y) fun yR => rest (some yR)
        | _ => rest none
  | _ => k ctx Y deepE shallowA

/-- `[[X]] e a` for a data type `X` (a `Prop`). -/
partial def relD (ctx : Ctx) (X e a : Expr) (κs : List EK := []) : GM Expr :=
  withBinders ctx true mkForallFVars X e a κs none fun ctx T e a => relBase ctx T e a

/-- The base relation `(SatRel.rel [[T]]) e a` of a non-Π data type. -/
partial def relBase (ctx : Ctx) (T e a : Expr) : GM Expr := do
  let R ← trTy ctx T
  let u ← getLevel T
  return mkAppN (Lean.mkConst (kitN "SatRel.rel") [u]) #[ctx.env, ctx.d, T, R, e, a]

/-- The relation data of a type or type family `y : Y` whose elements
have class `κ`. -/
partial def relTy (ctx : Ctx) (Y : Expr) (κ : EK) (y : Expr) : GM Expr :=
  withBinders ctx false mkForallFVars Y y y [] none fun ctx T _ ya => do
    match ← whnf T with
    | .sort _ => relData ctx κ ya
    | _ => return mkApp (← trTy ctx T) ya

/-- **The type-term translation** `[[T]]`: the relation data of the type
(or type family) `T`. -/
partial def trTy (ctx : Ctx) (T0 : Expr) : GM Expr := do
  let T ← whnfCore T0
  match T with
  | .sort u =>
    -- a universe: its elements are data types
    withLocalDeclD `Z (mkSort u) fun Z => do mkLambdaFVars #[Z] (← relData ctx .D Z)
  | .forallE .. =>
    match ← binderCls ctx T none with
    | .dat =>
      -- a function type as a type-term: its Π relation, saturated
      let u ← getLevel T
      let rel ← withLocalDeclD `fd clExprT fun fd => withLocalDeclD `f T fun f => do
        mkLambdaFVars #[fd, f] (← relD ctx T fd f)
      let sat ← withLocalDeclD `e clExprT fun e => withLocalDeclD `e' clExprT fun e' =>
        withLocalDeclD `f T fun f => do
          let redTy := mkAppN (Lean.mkConst ``ConLeche.Rules.Red) #[ctx.env, ctx.d, e, e']
          withLocalDeclD `h redTy fun h => do
            withLocalDeclD `H (← relD ctx T e' f) fun H => do
              mkLambdaFVars #[e, e', f, h, H] (← satD ctx T e e' f h H)
      return mkAppN (Lean.mkConst (kitN "SatRel.mk") [u]) #[ctx.env, ctx.d, T, rel, sat]
    | c => throwError "#boost: a type-term of class {repr c}:{indentExpr T}"
  | .lam nm Y b bi =>
    -- a type family
    let c ← binderCls ctx Y none
    withLocalDecl nm bi Y fun y => do
      match c with
      | .ty κ => withLocalDeclD (nm.appendAfter "R") (← relTy ctx Y κ y) fun yR => do
          let ctx' := ctx.push { x := y, cls := c, rel := yR }
          mkLambdaFVars #[y, yR] (← trTy ctx' (b.instantiate1 y))
      | _ =>
          let ctx' := ctx.push { x := y, cls := c }
          mkLambdaFVars #[y] (← trTy ctx' (b.instantiate1 y))
  | _ =>
    let h := T.getAppFn
    let args := T.getAppArgs
    match h with
    | .fvar _ =>
      let some ent := ctx.find? h | throwError "#boost: unknown type variable {h}"
      let some r := ent.rel | throwError "#boost: type variable without relation {h}"
      tyArgs ctx (← inferType h) r args
    | .const c us =>
      let κs ← inferKappas ctx (← instantiateTypeLevelParams (← getConstInfo c).toConstantVal us) args
      let nm ← ensureTyInst c us κs
      tyArgs ctx (← instantiateTypeLevelParams (← getConstInfo c).toConstantVal us)
        (mkApp2 (Lean.mkConst nm) ctx.env ctx.d) args
    | _ => throwError "#boost: type-term{indentExpr T}"

/-- Apply a type-level relation to shallow arguments (and the relation
data of the type arguments). -/
partial def tyArgs (ctx : Ctx) (ty r : Expr) (args : Array Expr) : GM Expr := do
  let mut ty := ty
  let mut r := r
  for a in args do
    let .forallE _ Y B _ ← whnf ty | throwError "#boost: tyArgs: not a Π"
    match ← binderCls ctx Y none with
    | .ty _ => r := mkApp2 r a (← trTy ctx a)
    | _ => r := mkApp r a
    ty := B.instantiate1 a
  return r

/-- `sat` of a data relation along `h : Red e e'`. -/
partial def satD (ctx : Ctx) (X e e' a h H : Expr) (κs : List EK := []) : GM Expr := do
  let Xw ← whnf X
  match Xw with
  | .forallE nm Z B bi =>
    let c ← binderCls ctx Z κs.head?
    let κs' := match c with | .ty _ => κs.drop 1 | _ => κs
    withLocalDeclD (nm.appendAfter "d") clExprT fun yd => do
    withLocalDeclD (nm.appendAfter "_cl") (mkClosedTy yd) fun hyd => do
    withLocalDecl nm bi Z fun y => do
      let go (yR? : Option Expr) : GM Expr := do
        let ctx' := ctx.push { x := y, cls := c, deep := yd, cl := hyd, rel := yR? }
        let args := #[yd, hyd, y] ++ yR?.toArray
        let h' := mkAppN (Lean.mkConst (redN "appFn")) #[ctx.env, ctx.d, e, e', yd, h]
        let body ← satD ctx' (B.instantiate1 y) (qApp e yd) (qApp e' yd) (mkApp a y) h'
          (mkAppN H args) κs'
        mkLambdaFVars args body
      match c with
      | .prf | .prop => go none
      | .ty κ => withLocalDeclD (nm.appendAfter "R") (← relTy ctx Z κ y) fun yR => go (some yR)
      | .dat => withLocalDeclD (nm.appendAfter "R") (← relD ctx Z yd y) fun yR => go (some yR)
  | _ =>
    let R ← trTy ctx X
    let u ← getLevel X
    return mkAppN (Lean.mkConst (kitN "SatRel.sat") [u]) #[ctx.env, ctx.d, X, R, e, e', a, h, H]

-- ## The term translation

/-- **`[[t]]`** for a data term `t` with deep counterpart `substS σ q 0`. -/
partial def trTerm (ctx : Ctx) (t q : Expr) (κs : List EK := []) : GM Expr := do
  match t with
  | .mdata _ b => trTerm ctx b q κs
  | .letE nm Y v b _ =>
    match dview q with
    | .letE qT qV qB =>
      -- Task #368: the stored value keeps its
      -- `let`s; the deep side takes ζ at the context (`Red.zetaS`), the
      -- shallow side a let-variable standing for the value
      let c ← binderCls ctx Y κs.head?
      let vR? ← match c with
        | .dat => some <$> trTerm ctx v qV
        | .prf | .prop => pure none
        | .ty _ => throwError "#boost: a type-valued `let`{indentExpr t}"
      let yd := qSubstS ctx.sigma qV
      let hyd := closedOf ctx qV
      withLetDecl nm Y v fun y => do
        let ctx' := (ctx.push { x := y, cls := c, deep := yd, cl := hyd, rel := vR? }).enterDeep yd hyd
        let bodyR ← trTerm ctx' (b.instantiate1 y) qB κs
        let red := mkAppN (Lean.mkConst (kitN "Red.zetaS")) #[ctx.env, ctx.d, ctx.sigma, ctx.hsigma,
          qT, qV, qB, hyd, boolRefl true]
        let e := qSubstS ctx.sigma q
        let e' := qSubstS ctx'.sigma qB
        let sat ← satD ctx' (← inferType (b.instantiate1 y)) e e' (b.instantiate1 y) red bodyR κs
        mkLetFVars #[y] sat
    | _ => trTerm ctx (b.instantiate1 v) q κs
  | .fvar _ =>
    let some ent := ctx.find? t | throwError "#boost: unknown variable {t}"
    let some r := ent.rel | throwError "#boost: variable without relation {t}"
    return r
  | .lit (.natVal n) => return mkApp3 (Lean.mkConst (kitN "natLit_R")) ctx.env ctx.d (mkRawNatLit n)
  | .lit (.strVal str) =>
    -- a string literal: the deep `strLit` step to its constructor form,
    -- then the translation of that form (`String.ofList [Char.ofNat n, …]`)
    let charT := Lean.mkConst ``Char
    let mirror := mkApp (Lean.mkConst ``String.ofList) <| str.toList.foldr
      (fun c e => mkApp3 (Lean.mkConst ``List.cons [.zero]) charT
        (mkApp (Lean.mkConst ``Char.ofNat) (mkRawNatLit c.toNat)) e)
      (mkApp (Lean.mkConst ``List.nil [.zero]) charT)
    let qs := toExpr (ConLeche.strLitToConstructor str)
    let body ← trTerm ctx mirror qs
    let hs ← needHyp (mkApp3 (Lean.mkConst ``Eq [1]) (Lean.mkConst ``Bool)
      (mkApp (Lean.mkConst ``ConLeche.strLitSupported) ctx.env) (Lean.mkConst ``Bool.true))
    let red := mkAppN (Lean.mkConst (redN "strLit")) #[ctx.env, ctx.d, toExpr str, hs]
    satD ctx (Lean.mkConst ``String) (qSubstS ctx.sigma q) (qSubstS ctx.sigma qs) t red body
  | .lam nm Y b bi =>
    let .lam qT qC := dview q | throwError "#boost: lockstep (λ){indentExpr q}"
    let tyw ← whnf (← inferType t)
    let .forallE _ _ Z _ := tyw | throwError "#boost: λ not at a Π"
    let c ← binderCls ctx Y κs.head?
    let κs' := match c with | .ty _ => κs.drop 1 | _ => κs
    withLocalDeclD (nm.appendAfter "d") clExprT fun yd => do
    withLocalDeclD (nm.appendAfter "_cl") (mkClosedTy yd) fun hyd => do
    withLocalDecl nm bi Y fun y => do
      let go (yR? : Option Expr) : GM Expr := do
        let ctx' := (ctx.push { x := y, cls := c, deep := yd, cl := hyd, rel := yR? }).enterDeep yd hyd
        let bodyR ← trTerm ctx' (b.instantiate1 y) qC κs'
        let red := mkAppN (Lean.mkConst (kitN "Red.betaS")) #[ctx.env, ctx.d, ctx.sigma, ctx.hsigma, yd, hyd,
          qT, qC, boolRefl true]
        let e := qApp (qSubstS ctx.sigma q) yd
        let e' := qSubstS ctx'.sigma qC
        let sat ← satD ctx' (Z.instantiate1 y) e e' (mkApp t y) red bodyR
        mkLambdaFVars (#[yd, hyd, y] ++ yR?.toArray) sat
      match c with
      | .prf | .prop => go none
      | .ty κ => withLocalDeclD (nm.appendAfter "R") (← relTy ctx Y κ y) fun yR => go (some yR)
      | .dat => withLocalDeclD (nm.appendAfter "R") (← relD ctx Y yd y) fun yR => go (some yR)
  | .proj S i s =>
    let .proj _ _ qs := dview q | throwError "#boost: lockstep (proj){indentExpr q}"
    let sty ← whnf (← inferType s)
    let .const _ us := sty.getAppFn | throwError "#boost: projection of a non-structure"
    let ps := sty.getAppArgs
    let sci ← getConstInfo S
    let κs ← inferKappas ctx (← instantiateTypeLevelParams sci.toConstantVal us) ps
    let nm ← ensureProjInst S i us κs
    let g ← needHyp (mkApp2 (Lean.mkConst (nm ++ `Good)) ctx.env ctx.d)
    let r ← tyArgs ctx (← instantiateTypeLevelParams sci.toConstantVal us) g ps
    return mkAppN r #[qSubstS ctx.sigma qs, closedOf ctx qs, s, ← trTerm ctx s qs]
  | .app .. | .const .. =>
    let h := t.getAppFn
    let args := t.getAppArgs
    let (qh, qargs) := qSpine q
    unless qargs.size == args.size do throwError "#boost: lockstep (spine){indentExpr t}"
    let (hp, κsH) ← headProof ctx h qh args
    let mut ty ← inferType h
    let mut cur := hp
    let mut κq := κsH
    for i in [0:args.size] do
      let a := args[i]!
      let qa := qargs[i]!
      let .forallE _ Y B _ ← whnf ty | throwError "#boost: application of a non-function{indentExpr t}"
      let c ← binderCls ctx Y κq.head?
      if let .ty _ := c then κq := κq.drop 1
      let da := qSubstS ctx.sigma qa
      let cl := closedOf ctx qa
      let r? ← match c with
        | .prf | .prop => pure none
        | .ty _ => some <$> trTy ctx a
        | .dat => some <$> trTerm ctx a qa
      cur := mkAppN cur (#[da, cl, a] ++ r?.toArray)
      ty := B.instantiate1 a
    return cur
  | _ => throwError "#boost: term{indentExpr t}"

/-- The relation of an application's head, and the element classes of
its type binders. -/
partial def headProof (ctx : Ctx) (h qh : Expr) (args : Array Expr) : GM (Expr × List EK) := do
  match h with
  | .fvar _ =>
    let some ent := ctx.find? h | throwError "#boost: unknown variable {h}"
    let some r := ent.rel | throwError "#boost: variable without relation {h}"
    return (r, [])
  | .const c us =>
    let ty ← instantiateTypeLevelParams (← getConstInfo c).toConstantVal us
    let κs ← inferKappas ctx ty args
    return (← constProof ctx c qh κs, κs)
  | _ => return (← trTerm ctx h qh, [])

/-- `closed (substS σ q 0)`. -/
partial def closedOf (ctx : Ctx) (q : Expr) : Expr :=
  mkAppN (Lean.mkConst (kitN "substS_closed")) #[ctx.sigma, ctx.hsigma, q, boolRefl true]

/-- A constant's lemma: a primitive of the kit, or the generated lemma
of its instance (a hypothesis of the lemma being built). -/
partial def constProof (ctx : Ctx) (c : Name) (qh : Expr) (κs : List EK) :
    GM Expr := do
  let env := ctx.env; let d := ctx.d
  if let some (lem, cn) := natOpLemma c then
    let hst ← needHyp (mkApp3 (Lean.mkConst ``Eq [1]) (Lean.mkConst ``Bool)
      (mkApp2 (Lean.mkConst ``ConLeche.natOpStored) env (Lean.mkConst cn)) (Lean.mkConst ``Bool.true))
    return mkApp3 (Lean.mkConst lem) env d hst
  if c == ``Nat.zero then return mkApp2 (Lean.mkConst (kitN "Nat.zero_R")) env d
  if c == ``Nat.succ then
    return mkApp3 (Lean.mkConst (kitN "Nat.succ_R")) env d (← natLitHyp env)
  if c == ``Bool.true then return mkApp2 (Lean.mkConst (kitN "Bool.true_R")) env d
  if c == ``Bool.false then return mkApp2 (Lean.mkConst (kitN "Bool.false_R")) env d
  let .const _ qus := dview qh | throwError "#boost: lockstep (const){indentExpr qh}"
  let dls ← (← decList qus).mapM fun q => decLevel q
  let nm ← ensureDataInst c dls κs
  needHyp (mkApp2 (Lean.mkConst (nm ++ `Good)) env d)

/-- The `natLitSupported` fact. -/
partial def natLitHyp (env : Expr) : GM Expr :=
  needHyp (mkApp3 (Lean.mkConst ``Eq [1]) (Lean.mkConst ``Bool) (mkApp (Lean.mkConst ``ConLeche.natLitSupported) env)
    (Lean.mkConst ``Bool.true))

-- ## Instances

/-- The instance name for a key. -/
partial def instName (c : Name) (tag : String) (key : String) : Name :=
  instNS ++ c ++ Name.mkSimple s!"{tag}{(hash key).toUSize % 1000000007}"

/-- Ensure the type-level instance `(c, us, κs)`; its name (a definition
`∀ env d, relTy …`). -/
partial def ensureTyInst (c : Name) (us : List Level) (κs : List EK) : GM Name := do
  if c == ``Nat then return kitN "Nat_R"
  if c == ``Bool then return kitN "Bool_R"
  let us ← us.mapM fun u => do return (← instantiateLevelMVars u).normalize
  let nm := instName c "T" s!"{us}|{repr κs}"
  if (← getEnv).contains nm then return nm
  try liftM (m := TermElabM) (withLCtx {} {} (genTyInst c us κs nm |>.run' {}))
  catch e => throwError "{c} (type level) ← {e.toMessageData}"
  return nm

/-- Ensure the data-level instance `(c, dls, κs)`; its name prefix
(`.Good` and `.R`). -/
partial def ensureDataInst (c : Name) (dls : List ConLeche.Level) (κs : List EK) : GM Name := do
  let nm := instName c "D" s!"{repr dls}|{repr κs}"
  if (← getEnv).contains (nm ++ `R) then return nm
  try liftM (m := TermElabM) (withLCtx {} {} (genDataInst c dls κs nm |>.run' {}))
  catch e => throwError "{c} ← {e.toMessageData}"
  return nm

/-- Ensure the projection instance. -/
partial def ensureProjInst (S : Name) (i : Nat) (us : List Level) (κs : List EK) : GM Name := do
  let us ← us.mapM fun u => do return (← instantiateLevelMVars u).normalize
  let nm := instName S s!"P{i}_" s!"{us}|{repr κs}"
  if (← getEnv).contains (nm ++ `R) then return nm
  try liftM (m := TermElabM) (withLCtx {} {} (genProjInst S i us κs nm |>.run' {}))
  catch e => throwError "{S}.{i} (field) ← {e.toMessageData}"
  return nm

-- ### Declaring

/-- Close a data lemma over its hypotheses and declare `nm.Good` and
`nm.R : ∀ env d, hyps → nm.Good env d`. -/
partial def declareData (nm : Name) (env d good proof : Expr) : GM Unit := do
  let goodV ← mkLambdaFVars #[env, d] good
  splice (nm ++ `Good) (← mkArrow (Lean.mkConst ``ConLeche.Env) (← mkArrow (Lean.mkConst ``Nat) (mkSort .zero))) goodV
  let hyps := (← get).hyps
  let fvs := hyps.map (·.2)
  let goal := mkApp2 (Lean.mkConst (nm ++ `Good)) env d
  let mut ty := goal.abstract fvs
  let mut val := proof.abstract fvs
  for i in (List.range hyps.size).reverse do
    let hty := (hyps[i]!.1).abstract (fvs.extract 0 i)
    ty := .forallE (Name.mkSimple s!"h{i}") hty ty .default
    val := .lam (Name.mkSimple s!"h{i}") hty val .default
  let ty' ← mkForallFVars #[env, d] ty
  let val' ← mkLambdaFVars #[env, d] val
  let decl : Declaration := .thmDecl { name := nm ++ `R, levelParams := [], type := ty', value := val' }
  withExporting (isExporting := true) do addDecl decl
  splice (nm ++ `size) (Lean.mkConst ``Nat) (mkRawNatLit (dagSize val'))

/-- The binders of a generated lemma. -/
partial def withEnvD (k : Expr → Expr → GM α) : GM α :=
  withLocalDeclD `env (Lean.mkConst ``ConLeche.Env) fun env => withLocalDeclD `d (Lean.mkConst ``Nat) fun d => k env d

-- ### Type-level instances

partial def genTyInst (c : Name) (us : List Level) (κs : List EK) (nm : Name) : GM Unit := do
  let ci ← getConstInfo c
  let ty ← instantiateTypeLevelParams ci.toConstantVal us
  let val ← withEnvD fun env d => do
    let ctx := Ctx.empty env d
    let body ← match ci with
      | .inductInfo iv =>
        if iv.isNested || iv.all.length > 1 then
          throwError "#boost: {c} is a mutual or nested inductive (not supported)"
        genIndRel ctx iv us ty κs
      | .defnInfo _ =>
        let v ← instantiateValueLevelParams ci us
        withBinders ctx false mkLambdaFVars ty (Lean.mkConst c us) (Lean.mkConst c us) κs none
          fun ctx' _ _ ya => do
            -- the value applied to the binders, β-reduced
            let args := ya.getAppArgs
            trTy ctx' (v.beta args)
      | .recInfo rv => genRecL ctx rv us ty κs
      | _ => throwError "#boost: no type-level instance for {c}"
    mkLambdaFVars #[env, d] body
  let ty' ← inferType val
  splice nm ty' val

/-- **An inductive type's relation**: `SatOf` of a core by the type's
own recursor — "a constructor application with closed, related fields". -/
partial def genIndRel (ctx : Ctx) (iv : InductiveVal) (us : List Level) (ty : Expr)
    (κs : List EK) : GM Expr := do
  withBinders ctx false mkLambdaFVars ty (Lean.mkConst iv.name us) (Lean.mkConst iv.name us) κs none
    fun ctx' _ _ ya => do
      let args := ya.getAppArgs
      let ps := args.extract 0 iv.numParams
      let ιs := args.extract iv.numParams args.size
      let some (.recInfo rv) := (← getEnv).find? (iv.name ++ `rec) | throwError "no rec"
      let recLvls := (Level.succ .zero) :: us
      let recC := Lean.mkConst rv.name recLvls
      let recTy ← instantiateForall (← inferType recC) ps
      let .forallE _ motTy _ _ ← whnf recTy | throwError "rec type"
      let motive ← forallTelescopeReducing motTy fun xs _ => do
        mkLambdaFVars xs (← mkArrow clExprT (mkSort .zero))
      let minTys ← do
        let t ← instantiateForall recTy #[motive]
        forallBoundedTelescope t (some rv.numMinors) fun ms _ => ms.mapM fun m => inferType m
      let ar ← minorArities rv recLvls
      let mut minors := #[]
      for j in [0:iv.ctors.length] do
        let cj := iv.ctors[j]!
        let some (.ctorInfo cv) := (← getEnv).find? cj | throwError "ctor"
        let mt := minTys[j]!
        let m ← forallBoundedTelescope mt (some ar[j]!) fun bs _ => do
          let ys := bs.extract 0 cv.numFields
          let ihs := bs.extract cv.numFields bs.size
          withLocalDeclD `e₀ clExprT fun e₀ => do
            let body ← ctorCore ctx' cj us ps ys ihs e₀
            mkLambdaFVars (bs.push e₀) body
        minors := minors.push m
      let x0 ← mkFreshUserName `t
      let tTy := mkAppN (Lean.mkConst iv.name us) args
      let core ← withLocalDeclD `e₀ clExprT fun e₀ => withLocalDeclD x0 tTy fun t => do
        mkLambdaFVars #[e₀, t] (mkAppN recC (ps ++ #[motive] ++ minors ++ ιs ++ #[t, e₀]))
      let u ← getLevel tTy
      return mkAppN (Lean.mkConst (kitN "SatOf") [u]) #[ctx.env, ctx.d, tTy, core]

/-- One constructor's core: `∃ us pd yd, Red e₀ (ctor us pd yd) ∧ closed yd ∧ related`. -/
partial def ctorCore (ctx : Ctx) (cj : Name) (us : List Level) (ps ys ihs : Array Expr)
    (e₀ : Expr) : GM Expr := do
  let some (.ctorInfo cv) := (← getEnv).find? cj | throwError "ctor"
  let nL := cv.levelParams.length
  let qn := toExpr (ConLeche.Name.ofLeanName cj)
  -- binder types of the fields, with the shallow params/fields
  let cty ← instantiateForall (← instantiateTypeLevelParams cv.toConstantVal us) ps
  let fTys ← forallBoundedTelescope cty (some cv.numFields) fun fs _ => do
    fs.mapM fun f => do return (← inferType f).replaceFVars fs ys
  let mut ctxF := ctx
  for k in [0:ys.size] do
    let Fk := fTys[k]!
    ctxF := ctxF.push { x := ys[k]!, cls := ← binderCls ctxF Fk none }
  let ctx := ctxF
  -- deep witnesses
  let lvlNames := (List.range nL).map fun i => Name.mkSimple s!"u{i}"
  let pdNames := (List.range ps.size).map fun i => Name.mkSimple s!"pd{i}"
  let ydNames := (List.range ys.size).map fun i => Name.mkSimple s!"yd{i}"
  withLocalDeclsDND (lvlNames.toArray.map (·, clLevelT)) fun uds => do
  withLocalDeclsDND (pdNames.toArray.map (·, clExprT)) fun pds => do
  withLocalDeclsDND (ydNames.toArray.map (·, clExprT)) fun yds => do
    let head := qConstE qn (qList clLevelT uds.toList)
    let red := mkAppN (Lean.mkConst ``ConLeche.Rules.Red) #[ctx.env, ctx.d, e₀, qMkAppN head (pds ++ yds).toList]
    let cls := yds.toList.map mkClosedTy
    let mut ihIdx := 0
    let mut rels : Array Expr := #[]
    for k in [0:ys.size] do
      let Fk := fTys[k]!
      match ← binderCls ctx Fk none with
      | .prf | .prop => rels := rels.push (Lean.mkConst ``True)
      | .ty _ => throwError "#boost: a type field in {cj}"
      | .dat =>
        let Fw ← whnf Fk
        if Fw.getAppFn.constName? == some cv.induct then
          -- recursive: the induction hypothesis, saturated
          let ih := ihs[ihIdx]!
          ihIdx := ihIdx + 1
          let r ← withLocalDeclD `e₁ clExprT fun e₁ => do
            let b := mkApp2 (Lean.mkConst ``And) (mkAppN (Lean.mkConst ``ConLeche.Rules.Red) #[ctx.env, ctx.d, yds[k]!, e₁])
              (mkApp ih e₁)
            mkLambdaFVars #[e₁] b
          rels := rels.push (mkApp2 (Lean.mkConst ``Exists [1]) clExprT r)
        else
          rels := rels.push (← relD ctx Fk yds[k]! ys[k]!)
    let body := mkConj (#[red, mkConj cls.toArray, mkConj rels])
    let body ← mkExistsFVars yds body
    let body ← mkExistsFVars pds body
    mkExistsFVars uds body

/-- `∃ x⃗, b`. -/
partial def mkExistsFVars (xs : Array Expr) (b : Expr) : MetaM Expr := do
  let mut b := b
  for x in xs.reverse do
    let ty ← inferType x
    let u ← getLevel ty
    b := mkApp2 (Lean.mkConst ``Exists [u]) ty (← mkLambdaFVars #[x] b)
  return b

/-- A right-nested conjunction (`True` when empty). -/
partial def mkConj (ps : Array Expr) : Expr :=
  if ps.isEmpty then Lean.mkConst ``True
  else ps.pop.foldr (fun p acc => mkApp2 (Lean.mkConst ``And) p acc) ps.back!

/-- The binder counts (fields + induction hypotheses) of a recursor's minors. -/
partial def minorArities (rv : RecursorVal) (us : List Level) : MetaM (Array Nat) := do
  forallTelescopeReducing (← inferType (Lean.mkConst rv.name us)) fun xs _ => do
    let ms := xs.extract (rv.numParams + rv.numMotives) (rv.numParams + rv.numMotives + rv.numMinors)
    ms.mapM fun m => do
      forallTelescopeReducing (← inferType m) fun bs _ => pure bs.size

/-- **A recursor at a type-valued motive**: the shallow recursor alone
(types' relations are deep-free). -/
partial def genRecL (ctx : Ctx) (rv : RecursorVal) (us : List Level) (ty : Expr)
    (κs : List EK) : GM Expr := do
  let ar ← minorArities rv us
  withBinders ctx false mkLambdaFVars ty (Lean.mkConst rv.name us) (Lean.mkConst rv.name us) κs none
    fun ctx' _ _ ya => do
      let args := ya.getAppArgs
      let nP := rv.numParams
      let ps := args.extract 0 nP
      let mot := args[nP]!
      let mins := args.extract (nP + 1) (nP + 1 + rv.numMinors)
      let ιt := args.extract (nP + 1 + rv.numMinors) args.size
      let some mR := (ctx'.find? mot).bind (·.rel) | throwError "genRecL: motive relation"
      let recC := Lean.mkConst rv.name us
      let tailTy ← instantiateForall (← inferType recC) (ps ++ #[mot] ++ mins)
      let (motive', lvl) ← forallTelescopeReducing tailTy fun xs _ => do
        let recApp := mkAppN recC (ps ++ #[mot] ++ mins ++ xs)
        let b := mkApp (mkAppN mR xs) recApp
        return (← mkLambdaFVars xs b, ← getLevel b)
      let recP := Lean.mkConst rv.name (lvl :: us.tail)
      let recTy' ← instantiateForall (← inferType recP) (ps.push motive')
      let minTys ← forallBoundedTelescope recTy' (some rv.numMinors) fun ms _ => ms.mapM fun m => inferType m
      let mut minors' := #[]
      for j in [0:rv.numMinors] do
        let nF := rv.rules[j]!.nfields
        let some mnR := (ctx'.find? mins[j]!).bind (·.rel) | throwError "genRecL: minor relation"
        let m ← forallBoundedTelescope minTys[j]! (some ar[j]!) fun bs _ => do
          let fs := bs.extract 0 nF
          let ihs := bs.extract nF bs.size
          let mut r := mnR
          let mut mty ← inferType mins[j]!
          for f in fs do
            let .forallE _ Y B _ ← whnf mty | throwError "genRecL: field"
            match ← binderCls ctx' Y none with
            | .ty _ => throwError "genRecL: a type field"
            | _ => r := mkApp r f
            mty := B.instantiate1 f
          for ih in ihs do
            let .forallE _ _ B _ ← whnf mty | throwError "genRecL: IH"
            -- the IH local's type is `motive' idx y` ≡ `mR idx y (rec … idx y)`
            let ihT := (← inferType ih).headBeta
            let recField := ihT.appArg!
            r := mkApp2 r recField ih
            mty := B.instantiate1 recField
          mkLambdaFVars bs r
        minors' := minors'.push m
      return mkAppN recP (ps ++ #[motive'] ++ minors' ++ ιt)

-- ### Data-level instances

partial def genDataInst (c : Name) (dls : List ConLeche.Level) (κs : List EK) (nm : Name) :
    GM Unit := do
  let ci ← getConstInfo c
  let us ← dls.mapM fun l => toLeanLevel l
  let ty ← instantiateTypeLevelParams ci.toConstantVal us
  let qc := qConstE (toExpr (ConLeche.Name.ofLeanName c)) (toExpr dls)
  ensurePinData #[c]
  withEnvD fun env d => do
    let ctx := Ctx.empty env d
    let good ← relD ctx ty qc (Lean.mkConst c us) κs
    let proof ← match ci with
      | .defnInfo dv => genDef ctx c dv dls us ty qc κs
      | .ctorInfo cv => genCtor ctx cv us ty qc κs
      | .recInfo rv =>
        if rv.name == ``Acc.rec then
          throwError "#boost: `Acc.rec` (well-founded recursion) is not translated"
        else genRecD ctx rv dls us ty qc κs
      | _ => throwError "#boost: no data-level lemma for {c}"
    declareData nm env d good proof

/-- **A definition**: `sat` along δ, then the translation of its body. -/
partial def genDef (ctx : Ctx) (c : Name) (dv : DefinitionVal) (dls : List ConLeche.Level)
    (us : List Level) (ty qc : Expr) (κs : List EK) : GM Expr := do
  let v ← instantiateValueLevelParams (.defnInfo dv) us
  let dval ← liftExcept (ConLeche.PinGen.toConLecheKeepLet dv.value)
  let dval := dval.instantiateLevelParams (dv.levelParams.map ConLeche.Name.ofLeanName) dls
  let qv := toExpr dval
  let pin ← needHyp (mkAppN (Lean.mkConst (kitN "DefPin")) #[ctx.env, Lean.mkConst (pinNS ++ c ++ `name),
    Lean.mkConst (pinNS ++ c ++ `lps), Lean.mkConst (pinNS ++ c ++ `val)])
  let qus := toExpr dls
  let hf := eqRefl clExprT (qConstE (Lean.mkConst (pinNS ++ c ++ `name)) qus)
  let hl := eqRefl (Lean.mkConst ``Nat) (mkRawNatLit dls.length)
  let red := mkAppN (Lean.mkConst (kitN "Red.deltaPin")) #[ctx.env, ctx.d, Lean.mkConst (pinNS ++ c ++ `name),
    Lean.mkConst (pinNS ++ c ++ `lps), Lean.mkConst (pinNS ++ c ++ `val), pin, qc, qus, hf, hl]
  let body ← trTerm ctx (← prepShallow v) qv κs
  satD ctx ty qc (qSubstS ctx.sigma qv) (Lean.mkConst c us) red body κs

/-- The shallow body as the deep one is built: `let` substituted, `mdata`
stripped. -/
partial def prepShallow (e : Expr) : MetaM Expr :=
  Core.transform e (pre := fun e => match e with
    | .mdata _ b => return .visit b
    | _ => return .continue)

/-- Goal-directed construction of `∃`/`∧` proofs: the witness/proof list
fills the goal's shape (read off its weak head). -/
partial def introExists (goal : Expr) (w : Expr) (k : Expr → GM Expr) : GM Expr := do
  let g ← whnf goal
  unless g.isAppOfArity ``Exists 2 do throwError "introExists: {g}"
  let α := g.appFn!.appArg!
  let p := g.appArg!
  let u ← getLevel α
  let pf ← k (p.beta #[w]).headBeta
  return mkApp4 (Lean.mkConst ``Exists.intro [u]) α p w pf

partial def introAnd (goal : Expr) (k₁ k₂ : Expr → GM Expr) : GM Expr := do
  let g ← whnf goal
  unless g.isAppOfArity ``And 2 do throwError "introAnd: {g}"
  let a := g.appFn!.appArg!
  let b := g.appArg!
  return mkApp4 (Lean.mkConst ``And.intro) a b (← k₁ a) (← k₂ b)

/-- A conjunction proof from a list of proofs (as `mkConj` shapes it). -/
partial def conjProof (goal : Expr) (pfs : List Expr) : GM Expr := do
  match pfs with
  | [] => return Lean.mkConst ``True.intro
  | [p] => return p
  | p :: ps => introAnd goal (fun _ => pure p) (fun g => conjProof g ps)

/-- **A constructor of a generated inductive**: by the relation's definition. -/
partial def genCtor (ctx : Ctx) (cv : ConstructorVal) (us : List Level) (ty qc : Expr)
    (κs : List EK) : GM Expr := do
  if cv.induct == ``Nat || cv.induct == ``Bool then throwError "#boost: primitive constructor"
  withBinders ctx true mkLambdaFVars ty qc (Lean.mkConst cv.name us) κs none fun ctx' T e a => do
    let goal ← relBase ctx' T e a
    let ents := ctx'.ents
    let pEnts := ents.extract 0 cv.numParams
    let fEnts := ents.extract cv.numParams ents.size
    let qus ← decList (qSpineHeadLevels e)
    introExists goal e fun g => introAnd g
      (fun _ => pure (mkApp3 (Lean.mkConst (redN "refl")) ctx.env ctx.d e))
      (fun g => do
        let mut ws : List Expr := qus ++ (pEnts.toList.map (·.deep.get!)) ++ (fEnts.toList.map (·.deep.get!))
        let rec go (g : Expr) (ws : List Expr) : GM Expr := do
          match ws with
          | w :: ws' => introExists g w fun g' => go g' ws'
          | [] =>
            let redP := mkApp3 (Lean.mkConst (redN "refl")) ctx.env ctx.d e
            let clP := fEnts.toList.map (·.cl.get!)
            let relP := fEnts.toList.map fun en => en.rel.getD (Lean.mkConst ``True.intro)
            let g ← whnf g
            introAnd g (fun _ => pure redP) fun g2 => introAnd g2
              (fun gc => conjProof gc clP) (fun gr => conjProof gr relP)
        go g ws)

/-- The level list of a quoted application's head constant. -/
partial def qSpineHeadLevels (e : Expr) : Expr :=
  match dview (qSpine e).1 with
  | .const _ us => us
  | _ => mkApp (Lean.mkConst ``List.nil [.zero]) clLevelT

-- ### Recursors

/-- **A recursor at a data motive**: by the shallow
recursor's own induction principle, with deep ι in each case. -/
partial def genRecD (ctx : Ctx) (rv : RecursorVal) (dls : List ConLeche.Level) (us : List Level)
    (ty qc : Expr) (κs : List EK) : GM Expr := do
  let I := rv.getMajorInduct
  ensurePinData #[I]
  withBinders ctx true mkLambdaFVars ty qc (Lean.mkConst rv.name us) κs none fun ctx' _ _ _ => do
    let ents := ctx'.ents
    let nP := rv.numParams; let nMi := rv.numMinors; let nI := rv.numIndices
    let pE := ents.extract 0 nP
    let motE := ents[nP]!
    let minE := ents.extract (nP + 1) (nP + 1 + nMi)
    let ιE := ents.extract (nP + 1 + nMi) (nP + 1 + nMi + nI)
    let tE := ents[nP + 1 + nMi + nI]!
    let ps := pE.map (·.x)
    -- the induction motive: ∀ deep indices and major (with relations), the goal
    let recC := Lean.mkConst rv.name us
    let tailTy ← instantiateForall (← inferType recC) (ps ++ #[motE.x] ++ minE.map (·.x))
    let qRecHead := qAppN qc ((pE.toList ++ [motE] ++ minE.toList).map (·.deep.get!))
    let mkGoalFor (ctxG : Ctx) (ιs : Array Expr) (t : Expr) (ιds : Array Expr) (td : Expr) : GM Expr := do
      let deepApp := qApp (ιds.foldl qApp qRecHead) td
      let shallowApp := mkAppN recC (ps ++ #[motE.x] ++ minE.map (·.x) ++ ιs ++ #[t])
      let mT ← instantiateForall tailTy (ιs.push t)
      relBase ctxG mT deepApp shallowApp
    let motive' ← forallTelescopeReducing tailTy fun xs _ => do
      let ιs := xs.extract 0 nI
      let t := xs[nI]!
      let inner ← withDeepFor ctx' (xs.toList) mkForallFVars fun ctxI dEnts => do
        mkGoalFor ctxI ιs t (dEnts.extract 0 nI |>.map (·.deep.get!)) (dEnts[nI]!.deep.get!)
      mkLambdaFVars xs inner
    let recP := Lean.mkConst rv.name (Level.zero :: us.tail)
    let recTy' ← instantiateForall (← inferType recP) (ps.push motive')
    let minTys ← forallBoundedTelescope recTy' (some nMi) fun ms _ => ms.mapM fun m => inferType m
    let ar ← minorArities rv us
    let mut minors' := #[]
    for j in [0:nMi] do
      let rl := rv.rules[j]!
      let m ← forallBoundedTelescope minTys[j]! (some ar[j]!) fun bs _ => do
        let fs := bs.extract 0 rl.nfields
        let ihs := bs.extract rl.nfields bs.size
        let ctorApp := mkAppN (Lean.mkConst rl.ctor (us.tail)) (ps ++ fs)
        let ctorTy ← inferType ctorApp
        let idxs := (← whnf ctorTy).getAppArgs.extract nP (nP + nI)
        let caseBody ← withDeepFor ctx' (idxs.toList ++ [ctorApp]) mkLambdaFVars fun ctxC dEnts => do
          let ιds := dEnts.extract 0 nI |>.map (·.deep.get!)
          let td := dEnts[nI]!.deep.get!
          let tR? := dEnts[nI]!.rel
          recCase ctxC rv rl j dls us qc pE motE minE fs ihs idxs ιds td tR? mkGoalFor
        mkLambdaFVars bs caseBody
      minors' := minors'.push m
    let ιsSh := ιE.map (·.x)
    let mut pf := mkAppN recP (ps ++ #[motive'] ++ minors' ++ ιsSh ++ #[tE.x])
    for en in ιE.push tE do
      pf := mkAppN pf (#[en.deep.get!, en.cl.get!] ++ en.rel.toArray)
    return pf


/-- Introduce the deep counterparts (and relations) of given shallow values. -/
partial def withDeepFor (ctx : Ctx) (vals : List Expr) (close : Array Expr → Expr → MetaM Expr)
    (k : Ctx → Array Ent → GM Expr) (acc : Array Ent := #[]) : GM Expr := do
  match vals with
  | [] => k ctx acc
  | v :: vs =>
    let Y ← inferType v
    let c ← binderCls ctx Y none
    withLocalDeclD `vd clExprT fun vd => withLocalDeclD `vd_cl (mkClosedTy vd) fun hvd => do
      let rest (r? : Option Expr) : GM Expr := do
        let en : Ent := { x := v, cls := c, deep := vd, cl := hvd, rel := r? }
        let body ← withDeepFor (ctx.push en) vs close k (acc.push en)
        close (#[vd, hvd] ++ r?.toArray) body
      match c with
      | .prf | .prop => rest none
      | .ty κ => withLocalDeclD `vR (← relTy ctx Y κ v) fun r => rest (some r)
      | .dat => withLocalDeclD `vR (← relD ctx Y vd v) fun r => rest (some r)

/-- One recursor case. -/
partial def recCase (ctx : Ctx) (rv : RecursorVal) (rl : RecursorRule) (j : Nat)
    (dls : List ConLeche.Level) (us : List Level) (qc : Expr) (pE : Array Ent) (motE : Ent)
    (minE : Array Ent) (fs ihs idxs ιds : Array Expr) (td : Expr) (tR? : Option Expr)
    (mkGoalFor : Ctx → Array Expr → Expr → Array Expr → Expr → GM Expr) : GM Expr := do
  let env := ctx.env; let d := ctx.d
  let ps := pE.map (·.x)
  let I := rv.getMajorInduct
  let ctorApp := mkAppN (Lean.mkConst rl.ctor us.tail) (ps ++ fs)
  let goal ← mkGoalFor ctx idxs ctorApp ιds td
  let deepArgsHead := (pE.toList ++ [motE] ++ minE.toList).map (·.deep.get!)
  let deepApp := qApp (ιds.foldl qApp (qAppN qc deepArgsHead)) td
  -- the deep step and the case's deep minor application
  let finish (redStep : Expr) (minorDeep : Expr) (minorRel : Expr) : GM Expr := do
    let mT ← instantiateForall
      (← instantiateForall (← inferType (Lean.mkConst rv.name us)) (ps ++ #[motE.x] ++ minE.map (·.x)))
      (idxs.push ctorApp)
    let R ← trTy ctx mT
    let u ← getLevel mT
    let shallow := mkAppN (Lean.mkConst rv.name us) (ps ++ #[motE.x] ++ minE.map (·.x) ++ idxs ++ #[ctorApp])
    return mkAppN (Lean.mkConst (kitN "SatRel.sat") [u]) #[env, d, mT, R, deepApp, minorDeep, shallow,
      redStep, minorRel]
  if rv.k then
    kCase ctx rv rl dls us pE motE minE deepApp finish
  else
    -- the view of the deep major
    withView ctx goal I rl.ctor pE fs td tR? fun vw => do
      ensurePinData #[rl.ctor]
      let pinRec ← needHyp (mkAppN (Lean.mkConst (kitN "RecPin")) #[env, Lean.mkConst (pinNS ++ rv.name ++ `name),
        Lean.mkConst (pinNS ++ rv.name ++ `lps), Lean.mkConst (pinNS ++ rv.name ++ `type),
        mkRawNatLit (rv.numParams + rv.numMotives + rv.numMinors + rv.numIndices),
        mkRawNatLit (rv.numParams + rv.numMotives + rv.numMinors), Lean.mkConst (pinNS ++ rv.name ++ `rules)])
      let pinCtor ← needHyp (mkAppN (Lean.mkConst (kitN "CtorPin")) #[env, Lean.mkConst (pinNS ++ rl.ctor ++ `name),
        Lean.mkConst (pinNS ++ rl.ctor ++ `lps), Lean.mkConst (pinNS ++ rl.ctor ++ `type)])
      let some (.inductInfo iv) := (← getEnv).find? I | throwError "ind"
      let pinInd ← needHyp (mkAppN (Lean.mkConst (kitN "IndNeverProp")) #[env, Lean.mkConst (pinNS ++ I ++ `name),
        mkRawNatLit iv.levelParams.length])
      let qus := toExpr dls
      let qCtor := qConstE (toExpr (ConLeche.Name.ofLeanName rl.ctor)) (qList clLevelT vw.levels)
      let major := qMkAppN qCtor (vw.pds ++ vw.yds)
      -- the native rule, at the instance levels
      let rhs ← liftExcept (ConLeche.PinGen.toConLeche rl.rhs)
      let rhs := rhs.instantiateLevelParams (rv.levelParams.map ConLeche.Name.ofLeanName) dls
      -- the STORED rule (`PinGen/BoostPins.lean`: the installation's bits)
      let some jr := rv.rules.findIdx? (·.ctor == rl.ctor) | throwError "rule index"
      let qrule := mkApp3 (Lean.mkConst ``List.getD [.zero]) (Lean.mkConst ``ConLeche.RecRule)
        (Lean.mkConst (pinNS ++ rv.name ++ `rules)) (mkRawNatLit jr) |>.app
          (mkApp2 (Lean.mkConst ``Inhabited.default [1]) (Lean.mkConst ``ConLeche.RecRule)
            (Lean.mkConst ``ConLeche.instInhabitedRecRule))
      let some (.ctorInfo cvj) := (← getEnv).find? rl.ctor | throwError "ctor"
      let ctyD ← liftExcept (ConLeche.PinGen.toConLeche cvj.type)
      let tus := match ctyD.piResult.getAppFn with
        | .const _ ls => ls
        | _ => []
      let mI := rv.numParams + rv.numMotives + rv.numMinors + rv.numIndices
      let rP := rv.numParams + rv.numMotives + rv.numMinors
      let hhead := eqRefl clExprT (qConstE (Lean.mkConst (pinNS ++ rv.name ++ `name)) qus)
      let hlen := eqRefl (Lean.mkConst ``Nat) (mkRawNatLit (mI + 1))
      let hus := eqRefl (Lean.mkConst ``Nat) (mkRawNatLit dls.length)
      let hmh := eqRefl clExprT (qConstE (Lean.mkConst (pinNS ++ rl.ctor ++ `name)) (qList clLevelT vw.levels))
      let hrule := eqRefl (mkApp (Lean.mkConst ``Option [.zero]) (Lean.mkConst ``ConLeche.RecRule))
        (mkApp2 (Lean.mkConst ``Option.some [.zero]) (Lean.mkConst ``ConLeche.RecRule) qrule)
      let hmlen := eqRefl (Lean.mkConst ``Nat) (mkRawNatLit (rv.numParams + rl.nfields))
      let hT := eqRefl clExprT (qConstE (Lean.mkConst (pinNS ++ I ++ `name)) (toExpr tus))
      let hk := eqRefl (Lean.mkConst ``Nat) (mkRawNatLit iv.levelParams.length)
      let hpeel := boolRefl true
      let red1 := mkAppN (Lean.mkConst (kitN "Red.iota2")) #[env, d,
        Lean.mkConst (pinNS ++ rv.name ++ `name), Lean.mkConst (pinNS ++ rv.name ++ `lps),
        Lean.mkConst (pinNS ++ rv.name ++ `type), mkRawNatLit mI, mkRawNatLit rP,
        Lean.mkConst (pinNS ++ rv.name ++ `rules), Lean.mkConst (pinNS ++ rl.ctor ++ `name),
        Lean.mkConst (pinNS ++ rl.ctor ++ `lps), Lean.mkConst (pinNS ++ rl.ctor ++ `type),
        Lean.mkConst (pinNS ++ I ++ `name), mkRawNatLit iv.levelParams.length,
        pinRec, pinCtor, pinInd, deepApp, qus, major, qList clLevelT vw.levels, qrule, toExpr tus,
        hhead, hlen, hus, vw.hmaj, hmh, hrule, hmlen, hT, hk, hpeel]
      -- β over the rule's λ-telescope
      let (tys, body) := peelLams rhs (rP + rl.nfields)
      let argsL := deepArgsHead ++ vw.yds
      let hArgs := allClosedProof ((pE.toList ++ [motE] ++ minE.toList).map (·.cl.get!) ++ vw.cls) argsL
      let red2 := mkAppN (Lean.mkConst (kitN "Red.betaSpine")) #[env, d,
        qList clExprT (tys.map toExpr), qList clExprT argsL, mkApp (Lean.mkConst ``List.nil [.zero]) clExprT,
        toExpr body, eqRefl (Lean.mkConst ``Nat) (mkRawNatLit tys.length), Lean.mkConst ``True.intro, hArgs,
        boolRefl true]
      let src := qMkAppN (qSubstS (mkApp (Lean.mkConst ``List.nil [.zero]) clExprT)
        (toExpr (lamNE tys body))) argsL
      let tgt := mkApp3 (Lean.mkConst (kitN "substS")) (mkApp2 (Lean.mkConst ``List.reverse [.zero]) clExprT
        (qList clExprT argsL)) (toExpr body) (mkRawNatLit 0)
      let tgtRed := mkAppN (Lean.mkConst (redN "trans")) #[env, d, deepApp, src, tgt, red1, red2]
      -- the minor's relation at the deep fields and the recursive calls
      let σrhs := mkApp2 (Lean.mkConst ``List.reverse [.zero]) clExprT (qList clExprT argsL)
      let hσrhs := mkApp2 (Lean.mkConst (kitN "AllClosed.reverse")) (qList clExprT argsL) hArgs
      let minorRel ← minorApp ctx rv rl j us pE motE minE fs ihs vw σrhs hσrhs body
      finish tgtRed tgt minorRel

/-- The rule's λ-telescope, peeled `n` deep. -/
partial def peelLams (e : ConLeche.Expr) (n : Nat) : List ConLeche.Expr × ConLeche.Expr :=
  match n, e with
  | 0, e => ([], e)
  | n + 1, .lam t b => let (ts, b') := peelLams b n; (t :: ts, b')
  | _, e => ([], e)

partial def lamNE : List ConLeche.Expr → ConLeche.Expr → ConLeche.Expr
  | [], b => b
  | t :: ts, b => .lam t (lamNE ts b)

/-- `AllClosed args` from the closedness proofs. -/
partial def allClosedProof (cls args : List Expr) : Expr :=
  match cls, args with
  | c :: cs, a :: as =>
    mkApp4 (Lean.mkConst ``And.intro) (mkClosedTy a) (mkApp (Lean.mkConst (kitN "AllClosed")) (qList clExprT as))
      c (allClosedProof cs as)
  | _, _ => Lean.mkConst ``True.intro

/-- The positions of a constructor's recursive fields. -/
partial def recFieldIdx (rv : RecursorVal) (rl : RecursorRule) : List Nat := Id.run do
  -- the rule's rhs: λ params motive minors fields. minor fields (rec … field)…
  let rec body (e : Lean.Expr) (n : Nat) : Lean.Expr :=
    match n, e with
    | 0, e => e
    | n + 1, .lam _ _ b _ => body b n
    | _, e => e
  let b := body rl.rhs (rv.numParams + rv.numMotives + rv.numMinors + rl.nfields)
  let args := b.getAppArgs
  let mut out := []
  for a in args.extract rl.nfields args.size do
    match a.getAppArgs.back? with
    | some (.bvar i) => out := out ++ [rl.nfields - 1 - i]
    | _ => pure ()
  return out

/-- The minor's relation applied to the case's deep fields and calls. -/
partial def minorApp (ctx : Ctx) (rv : RecursorVal) (rl : RecursorRule) (j : Nat) (us : List Level)
    (pE : Array Ent) (motE : Ent) (minE : Array Ent) (fs ihs : Array Expr) (vw : View)
    (σrhs hσrhs : Expr) (body : ConLeche.Expr) : GM Expr := do
  let some r0 := minE[j]!.rel | throwError "minor relation"
  let mut r := r0
  let mut ty ← inferType minE[j]!.x
  -- the fields, with their deep values and relations; also the context in
  -- which the recursive calls' indices are translated
  let mut ctxR : Ctx := { ctx with sigma := σrhs, sigmaLen := 0, hsigma := hσrhs }
  for k in [0:fs.size] do
    let .forallE _ Y B _ ← whnf ty | throwError "minorApp: field"
    let c ← binderCls ctx Y none
    let yd := vw.yds[k]!
    let rel? := match c with
      | .dat => some vw.rels[k]!
      | _ => none
    r := mkAppN r (#[yd, vw.cls[k]!, fs[k]!] ++ rel?.toArray)
    ctxR := ctxR.push { x := fs[k]!, cls := c, deep := yd, cl := vw.cls[k]!, rel := rel? }
    ty := B.instantiate1 fs[k]!
  -- the rule body's recursive calls: `minor fields… (rec ps mot mins idx… field)…`
  let calls := (body.getAppArgs.drop rl.nfields).toArray
  let nHead := rv.numParams + rv.numMotives + rv.numMinors
  let idx := recFieldIdx rv rl
  for l in [0:ihs.size] do
    let k := idx[l]!
    let .forallE _ Y B _ ← whnf ty | throwError "minorApp: IH"
    let call := calls[l]!
    let cargs := call.getAppArgs.toArray
    let idxSh := (Y.getAppArgs).extract 0 rv.numIndices
    let mut ihR := ihs[l]!
    for i in [0:rv.numIndices] do
      let qI := cargs[nHead + i]!
      let ish := idxSh[i]!
      let dI := mkApp3 (Lean.mkConst (kitN "substS")) σrhs (toExpr qI) (mkRawNatLit 0)
      let clI := mkAppN (Lean.mkConst (kitN "substS_closed")) #[σrhs, hσrhs, toExpr qI, boolRefl true]
      let rI? ← match ← binderCls ctx (← inferType ish) none with
        | .dat => some <$> trTerm ctxR ish (toExpr qI)
        | .ty _ => some <$> trTy ctxR ish
        | _ => pure none
      ihR := mkAppN ihR (#[dI, clI] ++ rI?.toArray)
    ihR := mkAppN ihR #[vw.yds[k]!, vw.cls[k]!, vw.rels[k]!]
    let ihd := mkApp3 (Lean.mkConst (kitN "substS")) σrhs (toExpr call) (mkRawNatLit 0)
    let hcl := mkAppN (Lean.mkConst (kitN "substS_closed")) #[σrhs, hσrhs, toExpr call, boolRefl true]
    let ihShallow := mkAppN (Lean.mkConst rv.name us)
      ((pE.map (·.x)) ++ #[motE.x] ++ minE.map (·.x) ++ idxSh ++ #[fs[k]!])
    r := mkAppN r #[ihd, hcl, ihShallow, ihR]
    ty := B.instantiate1 ihShallow
  return r

/-- `Exists.elim` on a hypothesis, with the goal the continuation proves
(read back from the continuation's result type). -/
partial def elimExists (goal h : Expr) (k : Expr → Expr → GM Expr) : GM Expr := do
  let ht ← whnf (← inferType h)
  unless ht.isAppOfArity ``Exists 2 do throwError "elimExists: {ht}"
  let α := ht.appFn!.appArg!
  let p := ht.appArg!
  let u ← getLevel α
  withLocalDeclD `w α fun w => withLocalDeclD `hw (p.beta #[w]).headBeta fun hw => do
    let body ← k w hw
    let f ← mkLambdaFVars #[w, hw] body
    return mkAppN (Lean.mkConst ``Exists.elim [u]) #[α, p, goal, h, f]

partial def elimExistsN (goal h : Expr) (n : Nat) (k : Array Expr → Expr → GM Expr)
    (acc : Array Expr := #[]) : GM Expr := do
  if n == 0 then k acc h
  else elimExists goal h fun w hw => elimExistsN goal hw (n - 1) k (acc.push w)

partial def andLeft (h : Expr) : GM Expr := do
  let t ← whnf (← inferType h)
  unless t.isAppOfArity ``And 2 do throwError "andLeft: {t}"
  return mkApp3 (Lean.mkConst ``And.left) t.appFn!.appArg! t.appArg! h

partial def andRight (h : Expr) : GM Expr := do
  let t ← whnf (← inferType h)
  unless t.isAppOfArity ``And 2 do throwError "andRight: {t}"
  return mkApp3 (Lean.mkConst ``And.right) t.appFn!.appArg! t.appArg! h

/-- The parts of a `mkConj`-shaped conjunction of `n` parts. -/
partial def conjParts (h : Expr) (n : Nat) : GM (List Expr) := do
  match n with
  | 0 => return []
  | 1 => return [h]
  | n + 1 => return (← andLeft h) :: (← conjParts (← andRight h) n)

/-- The view of a deep major at a constructor. -/
partial def withView (ctx : Ctx) (goal : Expr) (I cj : Name) (pE : Array Ent)
    (fs : Array Expr) (td : Expr) (tR? : Option Expr) (k : View → GM Expr) : GM Expr := do
  let env := ctx.env; let d := ctx.d
  let some tR := tR? | throwError "withView: no major relation"
  if I == ``Nat then
    let hs ← natLitHyp env
    if cj == ``Nat.zero then
      return ← k { hmaj := mkAppN (Lean.mkConst (kitN "natView0")) #[env, d, hs, td, tR],
                   levels := [], pds := [], yds := [], cls := [], rels := [] }
    else
      let n := fs[0]!
      let litN := mkApp (Lean.mkConst ``ConLeche.Expr.lit) (mkApp (Lean.mkConst ``ConLeche.Literal.natVal) n)
      return ← k { hmaj := mkAppN (Lean.mkConst (kitN "natViewS")) #[env, d, hs, td, n, tR],
                   levels := [], pds := [], yds := [litN], cls := [boolRefl true],
                   rels := [mkApp3 (Lean.mkConst (kitN "natLit_R")) env d n] }
  if I == ``Bool then
    let lem := if cj == ``Bool.true then "boolViewT" else "boolViewF"
    return ← k { hmaj := mkAppN (Lean.mkConst (kitN lem)) #[env, d, td, tR],
                 levels := [], pds := [], yds := [], cls := [], rels := [] }
  -- a generated relation: destruct `∃ e₀, Red td e₀ ∧ ∃ us pd yd, Red e₀ ctor ∧ cls ∧ rels`
  let some (.ctorInfo cv) := (← getEnv).find? cj | throwError "ctor"
  let nL := cv.levelParams.length
  let nF := cv.numFields
  elimExists goal tR fun e₀ h1 => do
    let h1a ← andLeft h1
    let h1b ← andRight h1
    elimExistsN goal h1b (nL + pE.size + nF) fun ws hw => do
      let levels := (ws.extract 0 nL).toList
      let pds := (ws.extract nL (nL + pE.size)).toList
      let yds := (ws.extract (nL + pE.size) ws.size).toList
      let hred ← andLeft hw
      let hrest ← andRight hw
      let hcls ← andLeft hrest
      let hrels ← andRight hrest
      let cls ← conjParts hcls nF
      let rels ← conjParts hrels nF
      let hmaj := mkAppN (Lean.mkConst (redN "trans")) #[env, d, td, e₀,
        qMkAppN (qConstE (toExpr (ConLeche.Name.ofLeanName cj)) (qList clLevelT levels)) (pds ++ yds),
        h1a, hred]
      k { hmaj, levels, pds, yds, cls, rels }

/-- A K-like recursor's case (`Eq.rec`): `Red.kRec` fires without the
major, β over the rule gives the minor, whose relation is the case's. -/
partial def kCase (ctx : Ctx) (rv : RecursorVal) (rl : RecursorRule) (dls : List ConLeche.Level)
    (us : List Level) (pE : Array Ent) (motE : Ent) (minE : Array Ent) (deepApp : Expr)
    (finish : Expr → Expr → Expr → GM Expr) : GM Expr := do
  let env := ctx.env; let d := ctx.d
  let _ := us
  unless rl.nfields == 0 && minE.size == 1 do throwError "kCase: not a K-like rule"
  let pinRec ← needHyp (mkAppN (Lean.mkConst (kitN "RecPin")) #[env, Lean.mkConst (pinNS ++ rv.name ++ `name),
    Lean.mkConst (pinNS ++ rv.name ++ `lps), Lean.mkConst (pinNS ++ rv.name ++ `type),
    mkRawNatLit (rv.numParams + rv.numMotives + rv.numMinors + rv.numIndices),
    mkRawNatLit (rv.numParams + rv.numMotives + rv.numMinors), Lean.mkConst (pinNS ++ rv.name ++ `rules)])
  let qus := toExpr dls
  let rhs0 ← liftExcept (ConLeche.PinGen.toConLeche rl.rhs)
  -- the STORED rule (`PinGen/BoostPins.lean`; at `Eq.rec`, the basis pin's)
  let qrule := mkApp3 (Lean.mkConst ``List.getD [.zero]) (Lean.mkConst ``ConLeche.RecRule)
    (Lean.mkConst (pinNS ++ rv.name ++ `rules)) (mkRawNatLit 0) |>.app
      (mkApp2 (Lean.mkConst ``Inhabited.default [1]) (Lean.mkConst ``ConLeche.RecRule)
        (Lean.mkConst ``ConLeche.instInhabitedRecRule))
  let mI := rv.numParams + rv.numMotives + rv.numMinors + rv.numIndices
  let rP := rv.numParams + rv.numMotives + rv.numMinors
  let red1 := mkAppN (Lean.mkConst (kitN "Red.kRecPin")) #[env, d,
    Lean.mkConst (pinNS ++ rv.name ++ `name), Lean.mkConst (pinNS ++ rv.name ++ `lps),
    Lean.mkConst (pinNS ++ rv.name ++ `type), mkRawNatLit mI, mkRawNatLit rP, qrule, pinRec,
    boolRefl true, eqRefl (Lean.mkConst ``Nat) (mkRawNatLit 0), deepApp, qus,
    eqRefl clExprT (qConstE (Lean.mkConst (pinNS ++ rv.name ++ `name)) qus),
    eqRefl (Lean.mkConst ``Nat) (mkRawNatLit (mI + 1)),
    eqRefl (Lean.mkConst ``Nat) (mkRawNatLit dls.length), boolRefl true]
  let rhs := rhs0.instantiateLevelParams (rv.levelParams.map ConLeche.Name.ofLeanName) dls
  let (tys, body) := peelLams rhs rP
  let headEnts := pE.toList ++ [motE] ++ minE.toList
  let argsL := headEnts.map (·.deep.get!)
  let hArgs := allClosedProof (headEnts.map (·.cl.get!)) argsL
  let nil := Lean.mkApp (Lean.mkConst ``List.nil [.zero]) clExprT
  let red2 := mkAppN (Lean.mkConst (kitN "Red.betaSpine")) #[env, d,
    qList clExprT (tys.map toExpr), qList clExprT argsL, nil, toExpr body,
    eqRefl (Lean.mkConst ``Nat) (mkRawNatLit tys.length), Lean.mkConst ``True.intro, hArgs, boolRefl true]
  let src := qMkAppN (qSubstS nil (toExpr (lamNE tys body))) argsL
  let tgt := mkApp3 (Lean.mkConst (kitN "substS")) (mkApp2 (Lean.mkConst ``List.reverse [.zero]) clExprT
    (qList clExprT argsL)) (toExpr body) (mkRawNatLit 0)
  let red := mkAppN (Lean.mkConst (redN "trans")) #[env, d, deepApp, src, tgt, red1, red2]
  let some mR := minE[0]!.rel | throwError "kCase: minor relation"
  finish red minE[0]!.deep.get! mR

/-- **A structure's field**: `∀ ps [pR] sd hsd s sR, [[Fᵢ]] (proj S i sd) s.i`,
by the structure's own recursor, the view of `sR`, `Red.projArg` and the
pinned projection step. -/
partial def genProjInst (S : Name) (i : Nat) (us : List Level) (κs : List EK) (nm : Name) :
    GM Unit := do
  let some (.inductInfo iv) := (← getEnv).find? S | throwError "genProjInst: {S}"
  let [cj] := iv.ctors | throwError "genProjInst: {S} is not a structure"
  let some (.ctorInfo cv) := (← getEnv).find? cj | throwError "ctor"
  ensurePinData #[cj]
  let sTy ← instantiateTypeLevelParams iv.toConstantVal us
  let qS := toExpr (ConLeche.Name.ofLeanName S)
  withEnvD fun env d => do
    let ctx := Ctx.empty env d
    let stmt (close : Array Expr → Expr → MetaM Expr)
        (body : Ctx → Array Expr → Expr → Expr → Expr → Expr → GM Expr) : GM Expr :=
      withBinders ctx false close sTy (Lean.mkConst S us) (Lean.mkConst S us) κs (some iv.numParams)
        fun ctx' _ _ ya => do
          let ps := ya.getAppArgs
          withLocalDeclD `sd clExprT fun sd => withLocalDeclD `sd_cl (mkClosedTy sd) fun hsd => do
          withLocalDeclD `s ya fun s => do
          withLocalDeclD `sR (← relD ctx' ya sd s) fun sR => do
            let b ← body (ctx'.push { x := s, cls := .dat, deep := sd, cl := hsd, rel := sR }) ps sd hsd s sR
            close #[sd, hsd, s, sR] b
    let fieldGoal (ctx' : Ctx) (sd s : Expr) : GM Expr := do
      let pr := Expr.proj S i s
      relD ctx' (← inferType pr) (mkApp3 (Lean.mkConst ``ConLeche.Expr.proj) qS (mkRawNatLit i) sd) pr
    let good ← stmt mkForallFVars fun ctx' _ sd _ s _ => fieldGoal ctx' sd s
    let proof ← stmt mkLambdaFVars fun ctx' ps sd hsd s sR => do
      -- the induction motive: ∀ sd hsd sR, the field goal
      let motive ← withLocalDeclD `t (mkAppN (Lean.mkConst S us) ps) fun t => do
        let inner ← withLocalDeclD `td clExprT fun td => withLocalDeclD `td_cl (mkClosedTy td) fun htd => do
          withLocalDeclD `tR (← relD ctx' (mkAppN (Lean.mkConst S us) ps) td t) fun tR => do
            mkForallFVars #[td, htd, tR] (← fieldGoal ctx' td t)
        mkLambdaFVars #[t] inner
      let recP := Lean.mkConst (S ++ `rec) (Level.zero :: us)
      let recTy ← instantiateForall (← inferType recP) (ps.push motive)
      let .forallE _ minTy _ _ ← whnf recTy | throwError "genProjInst: rec"
      let minor ← forallBoundedTelescope minTy (some cv.numFields) fun fs _ => do
        let ctorApp := mkAppN (Lean.mkConst cj us) (ps ++ fs)
        withLocalDeclD `td clExprT fun td => withLocalDeclD `td_cl (mkClosedTy td) fun htd => do
        withLocalDeclD `tR (← relD ctx' (mkAppN (Lean.mkConst S us) ps) td ctorApp) fun tR => do
          let goal ← fieldGoal ctx' td ctorApp
          let pE := ctx'.ents.extract 0 iv.numParams
          let body ← withView ctx' goal S cj pE fs td tR fun vw => do
            let pinP ← needHyp (mkAppN (Lean.mkConst (kitN "ProjPin")) #[env, qS, mkRawNatLit i,
              Lean.mkConst (pinNS ++ cj ++ `name), Lean.mkConst (pinNS ++ cj ++ `lps),
              mkRawNatLit cv.numParams, mkRawNatLit cv.numFields])
            let pinC ← needHyp (mkAppN (Lean.mkConst (kitN "CtorPin")) #[env, Lean.mkConst (pinNS ++ cj ++ `name),
              Lean.mkConst (pinNS ++ cj ++ `lps), Lean.mkConst (pinNS ++ cj ++ `type)])
            let qCtor := qConstE (toExpr (ConLeche.Name.ofLeanName cj)) (qList clLevelT vw.levels)
            let major := qMkAppN qCtor (vw.pds ++ vw.yds)
            let hhead := eqRefl clExprT (qConstE (Lean.mkConst (pinNS ++ cj ++ `name)) (qList clLevelT vw.levels))
            let hi := mkApp3 (Lean.mkConst ``of_decide_eq_true)
              (mkApp4 (Lean.mkConst ``LT.lt [.zero]) (Lean.mkConst ``Nat) (Lean.mkConst ``instLTNat) (mkRawNatLit i)
                (mkRawNatLit cv.numFields))
              (mkApp2 (Lean.mkConst ``Nat.decLt) (mkRawNatLit i) (mkRawNatLit cv.numFields)) (boolRefl true)
            let hlen := eqRefl (Lean.mkConst ``Nat) (mkRawNatLit (cv.numParams + cv.numFields))
            let hus := eqRefl (Lean.mkConst ``Nat) (mkRawNatLit vw.levels.length)
            let qProjT := mkApp3 (Lean.mkConst ``ConLeche.Expr.proj) qS (mkRawNatLit i)
            let step := mkAppN (Lean.mkConst (kitN "Red.projPin")) #[env, d, qS, mkRawNatLit i,
              Lean.mkConst (pinNS ++ cj ++ `name), Lean.mkConst (pinNS ++ cj ++ `lps), mkRawNatLit cv.numParams,
              mkRawNatLit cv.numFields, Lean.mkConst (pinNS ++ cj ++ `type), pinP, pinC, major,
              qList clLevelT vw.levels, hhead, hi, hlen, hus, boolRefl true]
            let red := mkAppN (Lean.mkConst (redN "trans")) #[env, d, qProjT td, qProjT major, vw.yds[i]!,
              mkAppN (Lean.mkConst (redN "projArg")) #[env, d, qS, mkRawNatLit i, td, major, vw.hmaj], step]
            let pr := Expr.proj S i ctorApp
            satD ctx' (← inferType pr) (qProjT td) vw.yds[i]! pr red vw.rels[i]!
          mkLambdaFVars (fs ++ #[td, htd, tR]) body
      return mkAppN recP (ps ++ #[motive, minor, s, sd, hsd, sR])
    declareData nm env d good proof

end

/-! ## The command -/

syntax (name := boostPinsCmd) "#boost_pins " ident* : command

@[command_elab boostPinsCmd] def elabBoostPins : CommandElab := fun stx => liftTermElabM do
  let cs ← stx[1].getArgs.mapM fun i => realizeGlobalConstNoOverload i
  ensurePinData cs

def goodOf? (t : Expr) : Option Name :=
  match t.getAppFn with
  | .const n _ => if n.components.getLast? == some `Good then some n.getPrefix else none
  | _ => none

/-- Topological order of the data instances below `root`. -/
partial def topo (root : Name) : StateT (Array Name × NameSet) MetaM Unit := do
  if (← get).2.contains root then return
  modify fun (o, s) => (o, s.insert root)
  let hs ← withLCtx {} {} do
    withLocalDeclD `env (Lean.mkConst ``ConLeche.Env) fun env => withLocalDeclD `d (Lean.mkConst ``Nat) fun d => do
      let ci ← getConstInfo (root ++ `R)
      let hs ← instantiateForall ci.type #[env, d] >>= fun t => forallTelescope t fun xs _ => xs.mapM fun x => inferType x
      return hs.map fun h => goodOf? h
  for h in hs do
    if let some n := h then topo n
  modify fun (o, s) => (o.push root, s)

syntax (name := boostCmd) "#boost " ident : command

@[command_elab boostCmd] def elabBoost : CommandElab := fun stx => liftTermElabM do
  let F ← realizeGlobalConstNoOverload stx[1]
  let root ← (ensureDataInst F [] []).run' {}
  let ((), (order, _)) ← (topo root).run (#[], {})
  -- the final theorem: all pins once, every lemma once
  let envT := Lean.mkConst ``ConLeche.Env
  withLocalDeclD `env envT fun env => withLocalDeclD `d (Lean.mkConst ``Nat) fun d => do
    let mut pinTys : Array Expr := #[]
    for n in order do
      let ci ← getConstInfo (n ++ `R)
      let t ← instantiateForall ci.type #[env, d]
      let hs ← forallTelescope t fun xs _ => xs.mapM fun x => inferType x
      for h in hs do
        if (goodOf? h).isNone && !pinTys.contains h then pinTys := pinTys.push h
    let pinNames := (List.range pinTys.size).toArray.map fun i => (Name.mkSimple s!"pin{i}", pinTys[i]!)
    withLocalDeclsDND pinNames fun pins => do
      let mut goods : Std.HashMap Name Expr := {}
      let mut lets : Array (Name × Expr × Expr) := #[]
      for n in order do
        let ci ← getConstInfo (n ++ `R)
        let t ← instantiateForall ci.type #[env, d]
        let hs ← forallTelescope t fun xs _ => xs.mapM fun x => inferType x
        let mut args := #[env, d]
        for h in hs do
          match goodOf? h with
          | some g => args := args.push goods[g]!
          | none => args := args.push pins[pinTys.idxOf h]!
        let v := mkAppN (Lean.mkConst (n ++ `R)) args
        let fv := mkFVar (← mkFreshFVarId)
        goods := goods.insert n fv
        lets := lets.push (Name.mkSimple s!"g{lets.size}", mkApp2 (Lean.mkConst (n ++ `Good)) env d, v)
      -- nest the lets
      let fvs := order.map fun n => goods[n]!
      let mut body := goods[root]!.abstract fvs
      for i in (List.range lets.size).reverse do
        let (nm, ty, v) := lets[i]!
        body := .letE nm (ty.abstract (fvs.extract 0 i)) (v.abstract (fvs.extract 0 i)) body false
      let goal := mkApp2 (Lean.mkConst (root ++ `Good)) env d
      let ty ← mkForallFVars (#[env, d] ++ pins) goal
      let val ← mkLambdaFVars (#[env, d] ++ pins) body
      addDecl (.thmDecl { name := F ++ `boost_rel, levelParams := [], type := ty, value := val })
      -- the literal corollary of a function of `Nat`s
      let fty ← inferType (Lean.mkConst F)
      let isNatFun ← forallTelescopeReducing fty fun xs r => do
        let ok ← xs.allM fun x => do return (← inferType x) == Lean.mkConst ``Nat
        return ok && (r == Lean.mkConst ``Nat || r == Lean.mkConst ``Bool) && xs.size > 0
      if isNatFun then
        let lit ← forallTelescopeReducing fty fun xs r => do
          let qF := qConstE (toExpr (ConLeche.Name.ofLeanName F)) (toExpr ([] : List ConLeche.Level))
          let lits := xs.map fun x => mkApp (Lean.mkConst ``ConLeche.Expr.lit)
            (mkApp (Lean.mkConst ``ConLeche.Literal.natVal) x)
          let deep := lits.foldl qApp qF
          let R := if r == Lean.mkConst ``Nat then Lean.mkConst (kitN "Nat_R") else Lean.mkConst (kitN "Bool_R")
          let stmt := mkAppN (Lean.mkConst (kitN "SatRel.rel") [1]) #[env, d, r, mkApp2 R env d, deep,
            mkAppN (Lean.mkConst F) xs]
          let mut pf := mkAppN (Lean.mkConst (F ++ `boost_rel)) (#[env, d] ++ pins)
          for (x, l) in xs.zip lits do
            pf := mkAppN pf #[l, boolRefl true, x, mkApp3 (Lean.mkConst (kitN "natLit_R")) env d x]
          return (← mkForallFVars (#[env, d] ++ pins ++ xs) stmt, ← mkLambdaFVars (#[env, d] ++ pins ++ xs) pf)
        addDecl (.thmDecl { name := F ++ `boost_lit, levelParams := [], type := lit.1, value := lit.2 })
      -- sizes: the generated proofs against the closure's definitions
      let mut proofSz := 0
      let mut defSz := 0
      for n in order do
        if let some (.defnInfo dv) := (← getEnv).find? (n ++ `size) then
          if let .lit (.natVal k) := dv.value then proofSz := proofSz + k
      let mut seen : NameSet := {}
      for n in order do
        let c := n.getPrefix.replacePrefix instNS .anonymous
        if seen.contains c then continue
        seen := seen.insert c
        if let some (.defnInfo dv) := (← getEnv).find? c then defSz := defSz + dagSize dv.value
      -- instance statistics over the whole closure (data lemmas, field
      -- lemmas, type-level relations), per constant
      let mut perConst : Std.HashMap Name Nat := {}
      let mut tyInst : Nat := 0
      for (n, _) in (← getEnv).constants.map₂.toList ++ (← getEnv).constants.map₁.toList do
        if !instNS.isPrefixOf n then continue
        let last := n.components.getLast?.getD .anonymous
        let isInst := (last == `R) || (n.components.length ≥ 2 && (last.toString.startsWith "T"))
        if !isInst then continue
        let base := if last == `R then n.getPrefix else n
        if last != `R then
          tyInst := tyInst + 1
        let c := base.getPrefix.replacePrefix instNS .anonymous
        perConst := perConst.insert c (perConst.getD c 0 + 1)
      let top := (perConst.toArray.qsort (fun a b => a.2 > b.2)).toList.take 8
      logInfo m!"#boost {F}: {order.size} lemmas, {pinTys.size} pins and facts; proof size {proofSz} (closure definitions {defSz}); environment: {perConst.size} constants translated, {tyInst} type-level relations; most instances: {top}"

/-! ## A sweep over a closure (measurement) -/

/-- The data dependencies of a constant (proofs and theorems skipped). -/
def dataDeps (n : Name) : MetaM (Array Name) := do
  let env ← getEnv
  let isProof (ci : ConstantInfo) : MetaM Bool := do
    if ci matches .thmInfo _ then return true
    try return (← inferType ci.type).isProp catch _ => return false
  let some ci := env.find? n | return #[]
  if ← isProof ci then return #[]
  let mut cs := ci.type.getUsedConstants
  if let some v := ci.value? (allowOpaque := true) then cs := cs ++ v.getUsedConstants
  match ci with
  | .inductInfo ii => cs := cs ++ ii.ctors.toArray
  | .recInfo ri => cs := cs ++ ri.rules.toArray.flatMap (·.rhs.getUsedConstants)
  | .ctorInfo cv => cs := cs.push cv.induct
  | _ => pure ()
  let mut out := #[]
  for c in cs do
    let some ci := env.find? c | continue
    unless ← isProof ci do out := out.push c
  return out

syntax (name := boostSweepCmd) "#boost_sweep " ident : command

/-- `#boost_sweep root`: generate the data lemma of every monomorphic,
non-proof definition in `root`'s data closure that reaches no opaque
constant, bottom-up; report what was translated and why the rest is not. -/
@[command_elab boostSweepCmd] def elabBoostSweep : CommandElab := fun stx => liftTermElabM do
  let root ← realizeGlobalConstNoOverload stx[1]
  let env ← getEnv
  -- the closure
  let mut seen : NameSet := {}
  let mut order : Array Name := #[]
  let mut todo := #[root]
  let mut depsOf : Std.HashMap Name (Array Name) := {}
  while !todo.isEmpty do
    let n := todo.back!; todo := todo.pop
    if seen.contains n then continue
    seen := seen.insert n
    let ds ← dataDeps n
    depsOf := depsOf.insert n ds
    order := order.push n
    for c in ds do unless seen.contains c do todo := todo.push c
  -- blocked: reaches an opaque constant
  let mut blocked : NameSet := {}
  for n in order do
    if let some (.opaqueInfo _) := env.find? n then blocked := blocked.insert n
  let mut changed := true
  while changed do
    changed := false
    for n in order do
      if blocked.contains n then continue
      if (depsOf.getD n #[]).any blocked.contains then
        blocked := blocked.insert n; changed := true
  let mut ok : Nat := 0
  let mut fails : Array (Name × String) := #[]
  let mut skippedPoly : Nat := 0
  for n in order.reverse do
    if blocked.contains n then continue
    let some (.defnInfo dv) := env.find? n | continue
    -- tactic-default parameters (`_auto`): syntax, only in proof binders' types
    if n.components.getLast?.map (·.toString.startsWith "_auto") == some true then continue
    if !dv.levelParams.isEmpty then skippedPoly := skippedPoly + 1; continue
    let isTyLevel ← forallTelescopeReducing dv.type fun _ r => do
      return (← whnf r).isSort || (← inferType r).isProp
    if isTyLevel then continue
    try
      let _ ← (ensureDataInst n [] []).run' {}
      ok := ok + 1
    catch e =>
      fails := fails.push (n, ((← e.toMessageData.toString).take 300).toString)
  logInfo m!"#boost_sweep {root}: closure {order.size}, blocked by opaque constants {blocked.size}; monomorphic definitions translated {ok}, polymorphic skipped as roots {skippedPoly}, failed {fails.size}"
  for (n, msg) in fails.toList.take 40 do
    logInfo m!"  failed {n}: {msg}"

end BoostGen

end
