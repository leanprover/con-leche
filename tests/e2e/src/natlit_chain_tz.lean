/- End-to-end performance fixture (DESIGN task #553, task #451's slow-module
   analysis): a fuel-driven count of trailing zero bits that shifts a
   65537-bit literal right by 64 bits per step, the shape of
   `Nat.trailingZeros` in lean4 master (lean4#15264).  Every shifted value is
   a distinct literal whose low 64 bits are zero, and `Hashable Nat` /
   `Literal.hash` read only those, so the literals share one `Expr` hash:
   the checker's whnf caches chain them in one bucket and every lookup
   compares against the whole chain, a number of literal comparisons
   quadratic in the shift count (lean4#15686; fixed upstream by
   lean4#16146's `Literal.natHash`, vendored in con-leche as task #547).
   Verdict today and target: accept; the cost is the point (see
   tests/e2e-expected.txt).  `Nat.trailingZeros` itself is not in the
   pinned toolchain, so the definition is copied here. -/

--#export tzChain1 tzChain2 tzChain3 tzChain4 tzChainBig Nat.pred Nat.add Nat.sub Nat.mul Nat.pow Nat.beq Nat.ble Nat.div Nat.mod Nat.gcd Nat.land Nat.lor Nat.xor Nat.shiftLeft Nat.shiftRight

noncomputable def tzCopy (n : Nat) : Nat :=
  let bits := fun (n : Nat) =>
    n.rec (fun _ => nat_lit 0) (fun _ ih n =>
      ((nat_lit 2).ble n).rec (nat_lit 0)
        (((n.mod (nat_lit 2)).beq (nat_lit 0)).rec (nat_lit 0)
          ((ih (n.div (nat_lit 2))).succ))) n
  n.rec (fun _ => nat_lit 0) (fun _ ih n =>
    (n.beq (nat_lit 0)).rec
      ((((nat_lit 0xffffffffffffffff).land n).beq (nat_lit 0)).rec
        (bits ((nat_lit 0xffffffffffffffff).land n))
        ((ih (Nat.shiftRight n (nat_lit 64))).add (nat_lit 64)))
      (nat_lit 0)) n

set_option maxRecDepth 100000 in
theorem tzChain1 : Eq (tzCopy (nat_lit )) (nat_lit 65537) :=
  Eq.refl (nat_lit 65537)

set_option maxRecDepth 100000 in
theorem tzChain2 : Eq (tzCopy (nat_lit )) (nat_lit 65537) :=
  Eq.refl (nat_lit 65537)

set_option maxRecDepth 100000 in
theorem tzChain3 : Eq (tzCopy (nat_lit )) (nat_lit 65537) :=
  Eq.refl (nat_lit 65537)

set_option maxRecDepth 100000 in
theorem tzChain4 : Eq (tzCopy (nat_lit )) (nat_lit 65537) :=
  Eq.refl (nat_lit 65537)

set_option maxRecDepth 100000 in
theorem tzChainBig : Eq (tzCopy (nat_lit )) (nat_lit 65537) :=
  Eq.refl (nat_lit 65537)
